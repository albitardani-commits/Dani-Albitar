    if not sec: abort(404)
    return render_template('admin/subsections.html', section=sec,
        subs=SubSection.query.filter_by(section_id=sid).order_by(SubSection.order_idx).all())

@app.route('/admin/subsections/add', methods=['POST'])
@admin_required
def admin_subsections_add():
    sid = request.form.get('section_id',type=int)
    na,ne,sl = request.form.get('name_ar','').strip(),request.form.get('name_en','').strip(),request.form.get('slug','').strip().lower().replace(' ','-')
    if sid and na and ne and sl:
        db.session.add(SubSection(section_id=sid,name_ar=na,name_en=ne,slug=sl,
            order_idx=SubSection.query.filter_by(section_id=sid).count()))
        db.session.commit()
        flash('Added','success')
    return redirect(url_for('admin_subsections', sid=sid))

@app.route('/admin/subsections/<int:subid>/edit', methods=['POST'])
@admin_required
def admin_subsections_edit(subid):
