@app.route('/admin/about/update', methods=['POST'])
@admin_required
def admin_about_update():
    for k in ['about_title','about_text']:
        sc = SiteContent.query.filter_by(key_name=k).first()
        if sc:
            sc.text_ar = request.form.get(f'{k}_ar',sc.text_ar).strip()
            sc.text_en = request.form.get(f'{k}_en',sc.text_en).strip()
    db.session.commit()
    flash('Updated','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/add', methods=['POST'])
@admin_required
def admin_team_add():
    na,ne = request.form.get('name_ar','').strip(),request.form.get('name_en','').strip()
    img = ''
    if 'image' in request.files:
        f = request.files['image']
        if f and f.filename and allowed_file(f.filename):
            fn = secure_filename(f.filename)
            f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
            img = fn
    if na and ne:
        db.session.add(TeamMember(name_ar=na,name_en=ne,
            role_ar=request.form.get('role_ar','').strip(),
            role_en=request.form.get('role_en','').strip(),
            skills_ar=request.form.get('skills_ar','').strip(),
            skills_en=request.form.get('skills_en','').strip(),image=img))
        db.session.commit()
        flash('Added','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/<int:mid>/edit', methods=['POST'])
@admin_required
def admin_team_edit(mid):
    m = db.session.get(TeamMember, mid)
    if m:
        m.name_ar=request.form.get('name_ar',m.name_ar).strip()
        m.name_en=request.form.get('name_en',m.name_en).strip()
        m.role_ar=request.form.get('role_ar',m.role_ar).strip()
        m.role_en=request.form.get('role_en',m.role_en).strip()
        m.skills_ar=request.form.get('skills_ar',m.skills_ar or '').strip()
        m.skills_en=request.form.get('skills_en',m.skills_en or '').strip()
        if 'image' in request.files:
            f = request.files['image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename)
                f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
                m.image = fn
        db.session.commit()
        flash('Updated','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/<int:mid>/delete', methods=['POST'])
@admin_required
def admin_team_delete(mid):
    m = db.session.get(TeamMember, mid)
    if m: db.session.delete(m); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_about'))

# --- Contact ---
@app.route('/admin/contact')
@admin_required
def admin_contact():
    return render_template('admin/contact.html',
        whatsapp=SiteContent.query.filter_by(key_name='contact_whatsapp').first(),
        email=SiteContent.query.filter_by(key_name='contact_email').first())

@app.route('/admin/contact/update', methods=['POST'])
@admin_required
def admin_contact_update():
    for k in ['contact_whatsapp','contact_email']:
        sc = SiteContent.query.filter_by(key_name=k).first()
        if sc:
            v = request.form.get(k,'').strip()
            sc.text_ar = v; sc.text_en = v
    db.session.commit()
    flash('Updated','success')
    return redirect(url_for('admin_contact'))

# --- Site Content ---
@app.route('/admin/site-content')
@admin_required
def admin_site_content():
    return render_template('admin/site_content.html', contents=SiteContent.query.all())

@app.route('/admin/site-content/update', methods=['POST'])
@admin_required
def admin_site_content_update():
    k = request.form.get('key_name','').strip()
    sc = SiteContent.query.filter_by(key_name=k).first()
    if not sc: sc = SiteContent(key_name=k); db.session.add(sc)
    sc.text_ar = request.form.get('text_ar','').strip()
    sc.text_en = request.form.get('text_en','').strip()
    db.session.commit()
    if request.headers.get('X-Requested-With') == 'XMLHttpRequest':
        return jsonify({'status':'ok'})
    flash('Updated','success')
    return redirect(url_for('admin_site_content'))

# --- Genius Page ---
@app.route('/admin/genius')
@admin_required
def admin_genius():
    content, sections, projects, team = get_site_data()
    return render_template('admin/genius.html', content=content, sections=sections, projects=projects, team=team)

# --- API ---
@app.route('/api/content/update', methods=['POST'])
@admin_required
def api_content_update():
    data = request.get_json()
    if not data or 'key' not in data: return jsonify({'error':'Missing key'}), 400
    sc = SiteContent.query.filter_by(key_name=data['key']).first()
    if not sc: sc = SiteContent(key_name=data['key']); db.session.add(sc)
    if 'text_ar' in data: sc.text_ar = data['text_ar']
    if 'text_en' in data: sc.text_en = data['text_en']
    db.session.commit()
    return jsonify({'status':'ok'})

@app.route('/api/subsections/<int:section_id>')
def api_subsections(section_id):
    subs = SubSection.query.filter_by(section_id=section_id).order_by(SubSection.order_idx).all()
    return jsonify([{'id':s.id,'name_ar':s.name_ar,'name_en':s.name_en,'slug':s.slug} for s in subs])

# --- Admins Management ---
@app.route('/admin/admins')
@super_admin_required
def admin_admins():
    return render_template('admin/admins.html', admins=Admin.query.all())

@app.route('/admin/admins/add', methods=['POST'])
@super_admin_required
def admin_admins_add():
    u,p = request.form.get('username','').strip(),request.form.get('password','')
    r = request.form.get('role','admin')
    if r not in ('admin','super_admin'): r = 'admin'
    if u and p:
        if not Admin.query.filter_by(username=u).first():
            db.session.add(Admin(username=u,password_hash=generate_password_hash(p),role=r))
            db.session.commit()
            flash('Added','success')
        else: flash('Username exists','error')
    return redirect(url_for('admin_admins'))

@app.route('/admin/admins/<int:aid>/delete', methods=['POST'])
@super_admin_required
def admin_admins_delete(aid):
    a = db.session.get(Admin, aid)
    if a and a.id != current_user.id:
        db.session.delete(a); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_admins'))

# --- Logo ---
@app.route('/admin/logo')
@admin_required
def admin_logo():
    return render_template('admin/logo.html',
        logo_content=SiteContent.query.filter_by(key_name='logo_size').first())

@app.route('/admin/logo/update', methods=['POST'])
@admin_required
def admin_logo_update():
    for field in ['logo_dark','logo_light']:
        if field in request.files:
            f = request.files[field]
            if f and f.filename and allowed_file(f.filename):
                fn = field + '.' + f.filename.rsplit('.',1)[1].lower()
                f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
    sz = request.form.get('logo_size','35')
    sc = SiteContent.query.filter_by(key_name='logo_size').first()
    if not sc: sc = SiteContent(key_name='logo_size',text_ar=sz,text_en=sz); db.session.add(sc)
    else: sc.text_ar = sz; sc.text_en = sz
    db.session.commit()
    flash('Updated','success')
    return redirect(url_for('admin_logo'))

if __name__ == '__main__':
    with app.app_context():
        db.create_all()
    app.run(debug=True, port=5000)
''')

