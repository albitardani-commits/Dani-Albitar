I'm experiencing a persistent issue with the file writing tools in this session. I'll provide you with a **single Python generator script** that you need to save as `generate_project.py` in your project root and run it. This script will create ALL the files needed for the complete overhaul.

Please save the following as `c:\Users\Dani\OneDrive\Desktop\netpal_website\generate_project.py` and run it with `python generate_project.py`:

```python
#!/usr/bin/env python3
"""
NetPal Website Generator - Complete Project Setup
Run this script from the project root to generate all files.
"""
import os

BASE = os.path.dirname(os.path.abspath(__file__))

def write_file(rel_path, content):
    full = os.path.join(BASE, rel_path)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, 'w', encoding='utf-8') as f:
        f.write(content)
    print(f"  Created: {rel_path}")

# =====================================================================
# 1. app.py
# =====================================================================
write_file('app.py', r'''import os
from flask import Flask, render_template, request, redirect, url_for, flash, jsonify, abort
from flask_sqlalchemy import SQLAlchemy
from flask_login import LoginManager, UserMixin, login_user, login_required, logout_user, current_user
from werkzeug.security import generate_password_hash, check_password_hash
from werkzeug.utils import secure_filename
from functools import wraps

app = Flask(__name__)
app.config['SECRET_KEY'] = 'netpal_super_secret_infinity_key_2026'
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///netpal.db'
app.config['UPLOAD_FOLDER'] = os.path.join('static', 'uploads')
app.config['MAX_CONTENT_LENGTH'] = 50 * 1024 * 1024
os.makedirs(app.config['UPLOAD_FOLDER'], exist_ok=True)

db = SQLAlchemy(app)
login_manager = LoginManager(app)
login_manager.login_view = 'admin_login'

ALLOWED_EXT = {'png','jpg','jpeg','gif','svg','webp','mp4','webm','mov'}
def allowed_file(fn):
    return '.' in fn and fn.rsplit('.',1)[1].lower() in ALLOWED_EXT

# ─── Models ───
class Admin(UserMixin, db.Model):
    id = db.Column(db.Integer, primary_key=True)
    username = db.Column(db.String(50), unique=True, nullable=False)
    password_hash = db.Column(db.String(255), nullable=False)
    role = db.Column(db.String(20), default='admin')

class Section(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    name_ar = db.Column(db.String(100), nullable=False)
    name_en = db.Column(db.String(100), nullable=False)
    slug = db.Column(db.String(50), unique=True, nullable=False)
    order_idx = db.Column(db.Integer, default=0)
    sub_sections = db.relationship('SubSection', backref='section', lazy=True, cascade='all, delete-orphan')
    projects = db.relationship('Project', backref='section', lazy=True, cascade='all, delete-orphan')

class SubSection(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    section_id = db.Column(db.Integer, db.ForeignKey('section.id'), nullable=False)
    name_ar = db.Column(db.String(100), nullable=False)
    name_en = db.Column(db.String(100), nullable=False)
    slug = db.Column(db.String(50), nullable=False)
    order_idx = db.Column(db.Integer, default=0)
    projects = db.relationship('Project', backref='sub_section', lazy=True)

class Project(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    title_ar = db.Column(db.String(200), nullable=False)
    title_en = db.Column(db.String(200), nullable=False)
    description_ar = db.Column(db.Text)
    description_en = db.Column(db.Text)
    section_id = db.Column(db.Integer, db.ForeignKey('section.id'), nullable=False)
    sub_section_id = db.Column(db.Integer, db.ForeignKey('sub_section.id'))
    cover_image = db.Column(db.String(255), nullable=False)
    video_url = db.Column(db.String(255))
    link_url = db.Column(db.String(255))
    tech_tags = db.Column(db.String(255))
    order_idx = db.Column(db.Integer, default=0)
    images = db.relationship('ProjectImage', backref='project', lazy=True, cascade='all, delete-orphan')

class ProjectImage(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    project_id = db.Column(db.Integer, db.ForeignKey('project.id'), nullable=False)
    image_path = db.Column(db.String(255), nullable=False)
    order_idx = db.Column(db.Integer, default=0)

class TeamMember(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    name_ar = db.Column(db.String(100), nullable=False)
    name_en = db.Column(db.String(100), nullable=False)
    role_ar = db.Column(db.String(100), nullable=False)
    role_en = db.Column(db.String(100), nullable=False)
    skills_ar = db.Column(db.Text)
    skills_en = db.Column(db.Text)
    image = db.Column(db.String(255))

class SiteContent(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    key_name = db.Column(db.String(100), unique=True, nullable=False)
    text_ar = db.Column(db.Text)
    text_en = db.Column(db.Text)

@login_manager.user_loader
def load_user(uid):
    return db.session.get(Admin, int(uid))

def admin_required(f):
    @wraps(f)
    def dec(*a, **kw):
        if not current_user.is_authenticated:
            return redirect(url_for('admin_login'))
        return f(*a, **kw)
    return dec

def super_admin_required(f):
    @wraps(f)
    def dec(*a, **kw):
        if not current_user.is_authenticated or current_user.role != 'super_admin':
            flash('Access denied', 'error')
            return redirect(url_for('admin_dashboard'))
        return f(*a, **kw)
    return dec

def get_site_data():
    sections = Section.query.order_by(Section.order_idx).all()
    content_raw = SiteContent.query.all()
    content = {c.key_name: {'ar': c.text_ar or '', 'en': c.text_en or ''} for c in content_raw}
    members = TeamMember.query.all()
    projects = Project.query.order_by(Project.order_idx).all()
    section_list = []
    for s in sections:
        subs = [{'id':sub.id,'name_ar':sub.name_ar,'name_en':sub.name_en,'slug':sub.slug}
                for sub in sorted(s.sub_sections, key=lambda x:x.order_idx)]
        section_list.append({'id':s.id,'name_ar':s.name_ar,'name_en':s.name_en,'slug':s.slug,'sub_sections':subs})
    project_list = []
    for p in projects:
        sec = db.session.get(Section, p.section_id)
        sub = db.session.get(SubSection, p.sub_section_id) if p.sub_section_id else None
        project_list.append({
            'id':p.id,'title_ar':p.title_ar,'title_en':p.title_en,
            'desc_ar':p.description_ar or '','desc_en':p.description_en or '',
            'section_slug':sec.slug if sec else '','sub_section_slug':sub.slug if sub else '',
            'cover':p.cover_image,'video':p.video_url,'link':p.link_url,
            'tags':p.tech_tags.split(',') if p.tech_tags else [],
            'images':[img.image_path for img in sorted(p.images, key=lambda x:x.order_idx)]
        })
    team_list = []
    for t in members:
        team_list.append({
            'id':t.id,'name_ar':t.name_ar,'name_en':t.name_en,
            'role_ar':t.role_ar,'role_en':t.role_en,
            'skills_ar':t.skills_ar.split(',') if t.skills_ar else [],
            'skills_en':t.skills_en.split(',') if t.skills_en else [],
            'image':t.image
        })
    return content, section_list, project_list, team_list

# ─── Main Routes ───
@app.route('/')
def index():
    content, sections, projects, team = get_site_data()
    return render_template('index.html', content=content, sections=sections, projects=projects, team=team)

@app.route('/project/<int:pid>')
def project_detail(pid):
    project = db.session.get(Project, pid)
    if not project: abort(404)
    content, sections, _, _ = get_site_data()
    sec = db.session.get(Section, project.section_id)
    sub = db.session.get(SubSection, project.sub_section_id) if project.sub_section_id else None
    proj = {
        'id':project.id,'title_ar':project.title_ar,'title_en':project.title_en,
        'desc_ar':project.description_ar or '','desc_en':project.description_en or '',
        'section_ar':sec.name_ar if sec else '','section_en':sec.name_en if sec else '',
        'sub_ar':sub.name_ar if sub else '','sub_en':sub.name_en if sub else '',
        'cover':project.cover_image,'video':project.video_url,'link':project.link_url,
        'tags':project.tech_tags.split(',') if project.tech_tags else [],
        'images':[img.image_path for img in sorted(project.images, key=lambda x:x.order_idx)]
    }
    return render_template('project_detail.html', project=proj, content=content, sections=sections)

# ─── Admin Auth ───
@app.route('/admin/login', methods=['GET','POST'])
def admin_login():
    if current_user.is_authenticated:
        return redirect(url_for('admin_dashboard'))
    if request.method == 'POST':
        u = request.form.get('username','').strip()
        p = request.form.get('password','')
        user = Admin.query.filter_by(username=u).first()
        if user and check_password_hash(user.password_hash, p):
            login_user(user)
            return redirect(url_for('admin_dashboard'))
        flash('Invalid credentials','error')
    return render_template('admin/login.html')

@app.route('/admin/logout')
@login_required
def admin_logout():
    logout_user()
    return redirect(url_for('admin_login'))

# ─── Admin Dashboard ───
@app.route('/admin')
@admin_required
def admin_dashboard():
    stats = {'sections':Section.query.count(),'projects':Project.query.count(),
             'team':TeamMember.query.count(),'admins':Admin.query.count()}
    return render_template('admin/dashboard.html', stats=stats)

# ─── Admin Sections ───
@app.route('/admin/sections')
@admin_required
def admin_sections():
    return render_template('admin/sections.html', sections=Section.query.order_by(Section.order_idx).all())

@app.route('/admin/sections/add', methods=['POST'])
@admin_required
def admin_sections_add():
    na,ne,sl = request.form.get('name_ar','').strip(), request.form.get('name_en','').strip(), request.form.get('slug','').strip().lower().replace(' ','-')
    if na and ne and sl:
        db.session.add(Section(name_ar=na,name_en=ne,slug=sl,order_idx=Section.query.count()))
        db.session.commit(); flash('Section added','success')
    return redirect(url_for('admin_sections'))

@app.route('/admin/sections/<int:sid>/edit', methods=['POST'])
@admin_required
def admin_sections_edit(sid):
    s = db.session.get(Section, sid)
    if s:
        s.name_ar = request.form.get('name_ar', s.name_ar).strip()
        s.name_en = request.form.get('name_en', s.name_en).strip()
        db.session.commit(); flash('Updated','success')
    return redirect(url_for('admin_sections'))

@app.route('/admin/sections/<int:sid>/delete', methods=['POST'])
@admin_required
def admin_sections_delete(sid):
    s = db.session.get(Section, sid)
    if s: db.session.delete(s); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_sections'))

# ─── Admin SubSections ───
@app.route('/admin/sections/<int:sid>/subsections')
@admin_required
def admin_subsections(sid):
    sec = db.session.get(Section, sid)
    if not sec: abort(404)
    return render_template('admin/subsections.html', section=sec,
        subs=SubSection.query.filter_by(section_id=sid).order_by(SubSection.order_idx).all())

@app.route('/admin/subsections/add', methods=['POST'])
@admin_required
def admin_subsections_add():
    sid = request.form.get('section_id', type=int)
    na,ne,sl = request.form.get('name_ar','').strip(), request.form.get('name_en','').strip(), request.form.get('slug','').strip().lower().replace(' ','-')
    if sid and na and ne and sl:
        db.session.add(SubSection(section_id=sid,name_ar=na,name_en=ne,slug=sl,
            order_idx=SubSection.query.filter_by(section_id=sid).count()))
        db.session.commit(); flash('Added','success')
    return redirect(url_for('admin_subsections', sid=sid))

@app.route('/admin/subsections/<int:subid>/edit', methods=['POST'])
@admin_required
def admin_subsections_edit(subid):
    sub = db.session.get(SubSection, subid)
    if sub:
        sub.name_ar = request.form.get('name_ar', sub.name_ar).strip()
        sub.name_en = request.form.get('name_en', sub.name_en).strip()
        db.session.commit(); flash('Updated','success')
    return redirect(url_for('admin_subsections', sid=sub.section_id))

@app.route('/admin/subsections/<int:subid>/delete', methods=['POST'])
@admin_required
def admin_subsections_delete(subid):
    sub = db.session.get(SubSection, subid)
    if sub:
        sid = sub.section_id; db.session.delete(sub); db.session.commit(); flash('Deleted','success')
        return redirect(url_for('admin_subsections', sid=sid))
    return redirect(url_for('admin_sections'))

# ─── Admin Projects ───
@app.route('/admin/projects')
@admin_required
def admin_projects():
    sec_slug = request.args.get('section','')
    secs = Section.query.order_by(Section.order_idx).all()
    if sec_slug:
        sec = Section.query.filter_by(slug=sec_slug).first()
        projs = Project.query.filter_by(section_id=sec.id).order_by(Project.order_idx).all() if sec else []
    else:
        projs = Project.query.order_by(Project.order_idx).all()
    return render_template('admin/projects.html', projects=projs, sections=secs, current_section=sec_slug)

@app.route('/admin/projects/add', methods=['GET','POST'])
@admin_required
def admin_projects_add():
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        ta,te = request.form.get('title_ar','').strip(), request.form.get('title_en','').strip()
        da,de = request.form.get('description_ar','').strip(), request.form.get('description_en','').strip()
        sid = request.form.get('section_id', type=int)
        subid = request.form.get('sub_section_id', type=int) or None
        vid,lnk,tags = request.form.get('video_url','').strip(), request.form.get('link_url','').strip(), request.form.get('tech_tags','').strip()
        cover = request.form.get('cover_url','').strip()
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); cover = fn
        if ta and te and sid and cover:
            p = Project(title_ar=ta,title_en=te,description_ar=da,description_en=de,
                section_id=sid,sub_section_id=subid,cover_image=cover,
                video_url=vid or None,link_url=lnk or None,tech_tags=tags or None,
                order_idx=Project.query.count())
            db.session.add(p); db.session.commit()
            if 'project_images' in request.files:
                for i,fi in enumerate(request.files.getlist('project_images')):
                    if fi and fi.filename and allowed_file(fi.filename):
                        fn = secure_filename(fi.filename); fi.save(os.path.join(app.config['UPLOAD_FOLDER'],fn))
                        db.session.add(ProjectImage(project_id=p.id,image_path=fn,order_idx=i))
                db.session.commit()
            flash('Project added','success'); return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs, subs=SubSection.query.all(), project=None)

@app.route('/admin/projects/<int:pid>/edit', methods=['GET','POST'])
@admin_required
def admin_projects_edit(pid):
    p = db.session.get(Project, pid)
    if not p: abort(404)
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        p.title_ar = request.form.get('title_ar', p.title_ar).strip()
        p.title_en = request.form.get('title_en', p.title_en).strip()
        p.description_ar = request.form.get('description_ar','').strip()
        p.description_en = request.form.get('description_en','').strip()
        p.section_id = request.form.get('section_id', type=int) or p.section_id
        p.sub_section_id = request.form.get('sub_section_id', type=int) or None
        p.video_url = request.form.get('video_url','').strip() or None
        p.link_url = request.form.get('link_url','').strip() or None
        p.tech_tags = request.form.get('tech_tags','').strip() or None
        cu = request.form.get('cover_url','').strip()
        if cu: p.cover_image = cu
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); p.cover_image = fn
        db.session.commit(); flash('Updated','success'); return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs, subs=SubSection.query.all(), project=p)

@app.route('/admin/projects/<int:pid>/delete', methods=['POST'])
@admin_required
def admin_projects_delete(pid):
    p = db.session.get(Project, pid)
    if p: db.session.delete(p); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_projects'))

# ─── Admin About / Team ───
@app.route('/admin/about')
@admin_required
def admin_about():
    return render_template('admin/about.html', members=TeamMember.query.all(),
        about_title=SiteContent.query.filter_by(key_name='about_title').first(),
        about_text=SiteContent.query.filter_by(key_name='about_text').first())

@app.route('/admin/about/update', methods=['POST'])
@admin_required
def admin_about_update():
    for k in ['about_title','about_text']:
        sc = SiteContent.query.filter_by(key_name=k).first()
        if sc:
            sc.text_ar = request.form.get(f'{k}_ar', sc.text_ar).strip()
            sc.text_en = request.form.get(f'{k}_en', sc.text_en).strip()
    db.session.commit(); flash('Updated','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/add', methods=['POST'])
@admin_required
def admin_team_add():
    na,ne = request.form.get('name_ar','').strip(), request.form.get('name_en','').strip()
    ra,re_ = request.form.get('role_ar','').strip(), request.form.get('role_en','').strip()
    sa,se = request.form.get('skills_ar','').strip(), request.form.get('skills_en','').strip()
    img = ''
    if 'image' in request.files:
        f = request.files['image']
        if f and f.filename and allowed_file(f.filename):
            fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); img = fn
    if na and ne:
        db.session.add(TeamMember(name_ar=na,name_en=ne,role_ar=ra,role_en=re_,skills_ar=sa,skills_en=se,image=img))
        db.session.commit(); flash('Added','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/<int:mid>/edit', methods=['POST'])
@admin_required
def admin_team_edit(mid):
    m = db.session.get(TeamMember, mid)
    if m:
        m.name_ar = request.form.get('name_ar', m.name_ar).strip()
        m.name_en = request.form.get('name_en', m.name_en).strip()
        m.role_ar = request.form.get('role_ar', m.role_ar).strip()
        m.role_en = request.form.get('role_en', m.role_en).strip()
        m.skills_ar = request.form.get('skills_ar', m.skills_ar or '').strip()
        m.skills_en = request.form.get('skills_en', m.skills_en or '').strip()
        if 'image' in request.files:
            f = request.files['image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); m.image = fn
        db.session.commit(); flash('Updated','success')
    return redirect(url_for('admin_about'))

@app.route('/admin/team/<int:mid>/delete', methods=['POST'])
@admin_required
def admin_team_delete(mid):
