# 4. templates/index.html
# =====================================================================
write_file('templates/index.html', r'''{% extends "base.html" %}
{% block content %}
<section class="hero" id="hero">
    <div id="three-canvas-container"></div>
    <div class="hero-particles-overlay"></div>
    <div class="hero-logo-container" id="hero-logo-container">
        <img src="{{ url_for('static', filename='images/لوغو نيتبال جديد-0١.svg') }}" alt="NetPal" class="hero-main-logo">
    </div>
    <div class="hero-content">
        <h1 class="hero-title" data-i18n="hero_title">{{ content.hero_title.ar }}</h1>
        <p class="hero-subtitle" data-i18n="hero_subtitle">{{ content.hero_subtitle.ar }}</p>
        <div class="hero-cta">
            <a href="#portfolio" class="btn btn-primary" data-i18n="cta_portfolio">استكشف أعمالنا</a>
            <a href="#contact" class="btn btn-outline" data-i18n="cta_contact">تواصل معنا</a>
        </div>
    </div>
    <div class="scroll-indicator">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </div>
</section>

<section id="about" class="container">
    <div class="section-header">
        <h2 class="section-title" data-i18n="nav_about">من نحن</h2>
        <div class="section-line"></div>
    </div>
    <div class="about-grid">
        <div class="about-text">
            <h3 data-i18n="about_title">{{ content.about_title.ar }}</h3>
            <p data-i18n="about_text">{{ content.about_text.ar }}</p>
            <ul class="about-features">
                <li data-i18n="feat_1">تصميم مبني على رؤية وهدف</li>
                <li data-i18n="feat_2">نظام عمل احترافي ومنظم</li>
                <li data-i18n="feat_3">تسليم سريع بجودة استثنائية</li>
            </ul>
        </div>
        <div class="team-grid" id="team-container"></div>
    </div>
</section>

<section id="portfolio" class="container">
    <div class="section-header">
        <h2 class="section-title" data-i18n="nav_portfolio">أعمالنا</h2>
        <div class="section-line"></div>
    </div>
    <div class="portfolio-tabs" id="section-tabs"></div>
    <div class="portfolio-subcategories" id="sub-tabs"></div>
    <div class="projects-grid" id="projects-container"></div>
</section>

<section id="contact" class="container contact-section">
    <div class="contact-bg"></div>
    <div class="section-header">
        <h2 class="section-title" data-i18n="contact_title">جاهزون لمشروعك القادم</h2>
        <div class="section-line"></div>
    </div>
    <div class="contact-actions">
        <a href="https://wa.me/{{ content.contact_whatsapp.ar }}" target="_blank" class="contact-btn glass-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <span data-i18n="btn_whatsapp">واتساب</span>
        </a>
        <a href="mailto:{{ content.contact_email.ar }}" class="contact-btn glass-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
            <span data-i18n="btn_email">إيميل</span>
        </a>
    </div>
</section>
{% endblock %}
''')


# =====================================================================
# 5. templates/project_detail.html
# =====================================================================
write_file('templates/project_detail.html', r'''{% extends "base.html" %}
{% block content %}
<section class="project-detail-hero">
    <div class="project-detail-cover">
        <img src="{{ project.cover }}" alt="Cover"
             onerror="this.src='/static/uploads/' + this.alt">
    </div>
    <div class="project-detail-overlay">
        <div class="container">
            <a href="/#portfolio" class="back-link" data-i18n="back_to_portfolio">← العودة لمعرض الأعمال</a>
            <h1 class="project-detail-title">
                <span class="pd-title-ar">{{ project.title_ar }}</span>
                <span class="pd-title-en" style="display:none">{{ project.title_en }}</span>
            </h1>
            <div class="project-detail-meta">
                <span class="pd-sec-ar">{{ project.section_ar }}</span>
                <span class="pd-sec-en" style="display:none">{{ project.section_en }}</span>
                {% if project.sub_ar %}
                <span class="meta-sep">›</span>
                <span class="pd-sub-ar">{{ project.sub_ar }}</span>
                <span class="pd-sub-en" style="display:none">{{ project.sub_en }}</span>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<section class="project-detail-body container">
    {% if project.tags %}
    <div class="pd-tags">
        {% for tag in project.tags %}<span class="skill-tag">{{ tag.strip() }}</span>{% endfor %}
    </div>
    {% endif %}

    <div class="pd-brief">
        <h2 data-i18n="project_brief">نبذة عن المشروع</h2>
        <p class="pd-desc-ar">{{ project.desc_ar }}</p>
        <p class="pd-desc-en" style="display:none">{{ project.desc_en }}</p>
    </div>

    {% if project.link %}
    <a href="{{ project.link }}" target="_blank" rel="noopener" class="btn btn-primary pd-link">
        <span data-i18n="site_visit">زيارة الموقع</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
    </a>
    {% endif %}

    {% if project.video %}
    <div class="pd-video">
        <video controls class="pd-video-player">
            <source src="/static/uploads/{{ project.video }}" type="video/mp4">
        </video>
    </div>
    {% endif %}

    {% if project.images %}
    <div class="pd-gallery">
        <h2 data-i18n="project_gallery">معرض المشروع</h2>
        <div class="pd-gallery-grid">
            {% for img in project.images %}
            <img src="/static/uploads/{{ img }}" alt="Project Image" class="pd-gallery-img" loading="lazy">
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Cover image at real size for projects with no gallery -->
    {% if not project.images and not project.video %}
    <div class="pd-gallery">
        <h2 data-i18n="project_gallery">معرض المشروع</h2>
        <div class="pd-gallery-grid single">
            <img src="{{ project.cover }}" alt="Project"
                 onerror="this.src='/static/uploads/' + this.alt"
                 class="pd-gallery-img" loading="lazy">
        </div>
    </div>
    {% endif %}
</section>

<script>
// Handle language for project detail page
document.addEventListener('DOMContentLoaded', () => {
    function updatePDLang() {
        const lang = window.currentLang || 'ar';
        document.querySelectorAll('.pd-title-ar,.pd-sec-ar,.pd-sub-ar,.pd-desc-ar').forEach(el => el.style.display = lang==='ar'?'':'none');
        document.querySelectorAll('.pd-title-en,.pd-sec-en,.pd-sub-en,.pd-desc-en').forEach(el => el.style.display = lang==='en'?'':'none');
    }
    window.updatePDLang = updatePDLang;
    setTimeout(updatePDLang, 100);
});
</script>
{% endblock %}
''')


# =====================================================================
# 6. templates/admin/login.html
# =====================================================================
write_file('templates/admin/login.html', r'''<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetPal Admin - Login</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <style>
        .login-page { min-height: 100vh; display: flex; justify-content: center; align-items: center; background: var(--bg-color); background-image: var(--bg-gradient); }
        .login-box { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 50px 40px; width: 400px; max-width: 90vw; text-align: center; backdrop-filter: blur(20px); }
        .login-box h1 { color: var(--primary); font-size: 2rem; margin-bottom: 30px; }
        .login-box input { width: 100%; padding: 15px 20px; margin-bottom: 15px; border-radius: 12px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.05); color: var(--text-color); font-family: inherit; font-size: 1rem; }
        .login-box input:focus { outline: none; border-color: var(--primary); }
        .login-box button { width: 100%; padding: 15px; border-radius: 12px; background: var(--primary); color: #000; font-weight: 700; font-size: 1.1rem; border: none; cursor: pointer; transition: 0.3s; }
        .login-box button:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(93,203,202,0.3); }
        .flash-msg { background: rgba(255,0,0,0.1); color: #ff6b6b; padding: 10px; border-radius: 8px; margin-bottom: 15px; }
    </style>
</head>
<body class="theme-dark">
    <div class="login-page">
        <div class="login-box">
            <h1>NetPal Admin</h1>
            {% with messages = get_flashed_messages() %}{% if messages %}{% for m in messages %}<div class="flash-msg">{{ m }}</div>{% endfor %}{% endif %}{% endwith %}
            <form method="POST">
                <input type="text" name="username" placeholder="Username" required autocomplete="username">
                <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
                <button type="submit">Login</button>
            </form>
        </div>
    </div>
</body>
</html>
''')


# =====================================================================
# 7. templates/admin/base.html
# =====================================================================
write_file('templates/admin/base.html', r'''<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetPal Admin</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <style>
        body { cursor: default !important; }
        a, button { cursor: pointer !important; }
        #custom-cursor, #cursor-trail { display: none !important; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: 260px; background: var(--card-bg); border-inline-end: 1px solid var(--border-color); padding: 20px 0; position: fixed; top: 0; bottom: 0; overflow-y: auto; z-index: 100; backdrop-filter: blur(20px); }
        .admin-sidebar .sidebar-logo { text-align: center; padding: 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px; }
        .admin-sidebar .sidebar-logo img { height: 40px; }
        .admin-sidebar nav a { display: flex; align-items: center; gap: 12px; padding: 12px 25px; color: var(--text-muted); transition: 0.3s; font-size: 0.95rem; }
        .admin-sidebar nav a:hover, .admin-sidebar nav a.active { color: var(--primary); background: rgba(93,203,202,0.05); border-inline-start: 3px solid var(--primary); }
        .admin-sidebar nav a svg { width: 18px; height: 18px; flex-shrink: 0; }
        .sidebar-section { padding: 10px 25px 5px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); opacity: 0.5; }
        .admin-main { flex: 1; margin-inline-start: 260px; padding: 30px; }
        .admin-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); }
        .admin-topbar h1 { font-size: 1.8rem; color: var(--primary); }
        .admin-topbar-actions { display: flex; gap: 10px; align-items: center; }
        .admin-topbar-actions .nav-btn { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.05); color: var(--text-color); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color); font-weight: bold; font-size: 0.8rem; transition: 0.3s; }
        .admin-topbar-actions .nav-btn:hover { background: var(--primary); color: #000; }
        .admin-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 25px; margin-bottom: 20px; backdrop-filter: blur(10px); }
        .admin-card h3 { color: var(--primary); margin-bottom: 15px; font-size: 1.2rem; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 25px; text-align: center; }
        .stat-card .stat-num { font-size: 3rem; font-weight: 700; color: var(--primary); }
        .stat-card .stat-label { font-size: 0.9rem; color: var(--text-muted); margin-top: 5px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; color: var(--text-muted); font-size: 0.9rem; }
        .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 12px 15px; border-radius: 10px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.05); color: var(--text-color); font-family: inherit; font-size: 0.95rem; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: var(--primary); }
        .form-group textarea { min-height: 100px; resize: vertical; }
        .btn-admin { padding: 10px 25px; border-radius: 10px; font-weight: 700; font-size: 0.95rem; transition: 0.3s; border: none; cursor: pointer; }
        .btn-admin-primary { background: var(--primary); color: #000; }
        .btn-admin-primary:hover { box-shadow: 0 5px 15px rgba(93,203,202,0.3); transform: translateY(-2px); }
        .btn-admin-danger { background: #ff4757; color: #fff; }
        .btn-admin-danger:hover { box-shadow: 0 5px 15px rgba(255,71,87,0.3); }
        .btn-admin-outline { background: transparent; border: 1px solid var(--border-color); color: var(--text-color); }
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th, .admin-table td { padding: 12px 15px; text-align: start; border-bottom: 1px solid var(--border-color); }
        .admin-table th { color: var(--primary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; }
        .admin-table tr:hover { background: rgba(93,203,202,0.03); }
        .action-btns { display: flex; gap: 8px; }
        .flash-success { background: rgba(93,203,202,0.1); color: var(--primary); padding: 12px 20px; border-radius: 10px; margin-bottom: 20px; }
        .flash-error { background: rgba(255,0,0,0.1); color: #ff6b6b; padding: 12px 20px; border-radius: 10px; margin-bottom: 20px; }
        .modal-admin { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; justify-content: center; align-items: center; }
        .modal-admin.active { display: flex; }
        .modal-admin-content { background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 16px; padding: 30px; width: 500px; max-width: 90vw; max-height: 80vh; overflow-y: auto; }
        .modal-admin-content h3 { color: var(--primary); margin-bottom: 20px; }
        @media (max-width: 768px) {
            .admin-sidebar { width: 100%; position: relative; }
            .admin-main { margin-inline-start: 0; }
            .admin-layout { flex-direction: column; }
        }
    </style>
</head>
