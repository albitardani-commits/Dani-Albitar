    ra,re_ = request.form.get('role_ar','').strip(), request.form.get('role_en','').strip()
    sa,se = request.form.get('skills_ar','').strip(), request.form.get('skills_en','').strip()
    img = ''
    if 'image' in request.files:
        f = request.files['image']
        if f and f.filename and allowed_file(f.filename):
