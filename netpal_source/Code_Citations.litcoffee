@app.route('/admin/sections/add', methods=['POST'])
@admin_required
def admin_sections_add():
    na,ne,sl = request.form.get('name_ar','').strip(),request.form.get('name_en','').strip(),request.form.get('slug','').strip().lower().replace(' ','-')
    if na and ne and sl:
        db.session.add(Section(name_ar=na,name_en=ne,slug=sl,order_idx=Section.query.count()))
        db.session.commit()
        flash('Section added','success')
