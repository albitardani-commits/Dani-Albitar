        ('يارا','Yara','مديرة التسويق الرقمي','Digital Marketing Manager',
         'سوشيال ميديا,إعلانات ممولة,تحليل بيانات,محتوى','Social Media,Paid Ads,Analytics,Content'),
    ]
    for na,ne,ra,re,sa,se in team:
        db.session.add(TeamMember(name_ar=na,name_en=ne,role_ar=ra,role_en=re,skills_ar=sa,skills_en=se,
                                  image='\u0644\u0648\u063a\u0648 \u0646\u064a\u062a\u0628\u0627\u0644 \u062c\u062f\u064a\u062f-0\u0661.png'))

    # ─── Sections ───
    sec_graphic = Section(name_ar='تصميم جرافيك', name_en='Graphic Design', slug='graphic', order_idx=0)
    sec_motion = Section(name_ar='موشن ومونتاج', name_en='Motion & Editing', slug='motion', order_idx=1)
