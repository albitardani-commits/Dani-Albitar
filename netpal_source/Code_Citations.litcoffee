         'da':'بناء استراتيجية محتوى شاملة لشركة مع تقويم تحريري ومقالات محسنة.',
         'de':'Building a comprehensive content strategy for a company with editorial calendar and optimized articles.',
         'sid':sec_market.id,'subid':sub_seo.id,'cover':imgs['seo1']},

        # ── Marketing > Ads ──
        {'ta':'حملة إعلانية لتطبيق','te':'App Advertising Campaign',
         'da':'حملة إعلانات ممولة على فيسبوك وإنستغرام لتطبيق جديد مع تكلفة تحميل منخفضة.',
         'de':'Paid advertising campaign on Facebook and Instagram for a new app with low cost-per-install.',
         'sid':sec_market.id,'subid':sub_ads.id,'cover':imgs['ads1']},
        {'ta':'حملة Google Ads لعيادة','te':'Google Ads for Clinic',
         'da':'إدارة حملات Google Ads لعيادة تجميل مع ROI مرتفع.',
         'de':'Google Ads campaign management for a beauty clinic with high ROI.',
         'sid':sec_market.id,'subid':sub_ads.id,'cover':imgs['ads1']},
        {'ta':'حملة إعلانية متكاملة','te':'Integrated Ad Campaign',
         'da':'حملة إعلانية متكاملة تشمل فيسبوك وجوجل وتيك توك لعلامة أزياء.',
         'de':'Integrated advertising campaign across Facebook, Google, and TikTok for a fashion brand.',
         'sid':sec_market.id,'subid':sub_ads.id,'cover':imgs['smm2']},
    ]

    for i, p in enumerate(projects_data):
        pj = Project(
            title_ar=p['ta'], title_en=p['te'],
            description_ar=p.get('da',''), description_en=p.get('de',''),
            section_id=p['sid'], sub_section_id=p.get('subid'),
            cover_image=p['cover'],
            video_url=p.get('video'), link_url=p.get('link'),
            tech_tags=p.get('tags'), order_idx=i
        )
        db.session.add(pj)

    db.session.commit()
    print(f"Database seeded! {Project.query.count()} projects, {Section.query.count()} sections, {SubSection.query.count()} sub-sections.")
