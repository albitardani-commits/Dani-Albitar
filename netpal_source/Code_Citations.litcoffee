        'social2': 'https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=800&q=80',
        'social3': 'https://images.unsplash.com/photo-1611162618071-b39a2ec055fb?w=800&q=80',
        'logo1': 'https://images.unsplash.com/photo-1626785774573-4b799315345d?w=800&q=80',
        'logo2': 'https://images.unsplash.com/photo-1614036417651-efe5912149d8?w=800&q=80',
