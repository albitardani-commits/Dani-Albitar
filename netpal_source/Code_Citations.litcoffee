@app.route('/admin/site-content/update', methods=['POST'])
@admin_required
def admin_site_content_update():
    k = request.form.get('key_name','').strip()
    sc = SiteContent.query.filter_by(key_name=k).first()
    if not sc: sc = SiteContent(key_name=k); db.session.add(sc)
    sc.text_ar = request.form.get('text_ar','').strip()
    sc.text_en = request.form.get('text_en','').strip()
    db.session.commit()
