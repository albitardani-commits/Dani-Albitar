    return render_template('admin/genius.html', content=content, sections=sections, projects=projects, team=team)

# ─── API ───
@app.route('/api/content/update', methods=['POST'])
@admin_required
def api_content_update():
    data = request.get_json()
    if not data or 'key' not in data: return jsonify({'error':'Missing key'}), 400
    sc = SiteContent.query.filter_by(key_name=data['key']).first()
    if not sc: sc = SiteContent(key_name=data['key']); db.session.add(sc)
    if 'text_ar' in data: sc.text_ar = data['text_ar']
    if 'text_en' in data: sc.text_en = data['text_en']
    db.session.commit()
    return jsonify({'status':'ok'})

@app.route('/api/subsections/<int:section_id>')
def api_subsections(section_id):
    subs = SubSection.query.filter_by(section_id=section_id).order_by(SubSection.order_idx).all()
    return jsonify([{'id':s.id,'name_ar':s.name_ar,'name_en':s.name_en,'slug':s.slug} for s in subs])

# ─── Admin Management ───
@app.route('/admin/admins')
@super_admin_required
def admin_admins():
    return render_template('admin/admins.html', admins=Admin.query.all())

@app.route('/admin/admins/add', methods=['POST'])
@super_admin_required
def admin_admins_add():
    u,p,r = request.form.get('username','').strip(), request.form.get('password',''), request.form.get('role','admin')
    if r not in ('admin','super_admin'): r = 'admin'
    if u and p:
        if not Admin.query.filter_by(username=u).first():
            db.session.add(Admin(username=u,password_hash=generate_password_hash(p),role=r))
            db.session.commit(); flash('Added','success')
        else: flash('Username exists','error')
    return redirect(url_for('admin_admins'))

@app.route('/admin/admins/<int:aid>/delete', methods=['POST'])
@super_admin_required
def admin_admins_delete(aid):
    a = db.session.get(Admin, aid)
    if a and a.id != current_user.id:
        db.session.delete(a); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_admins'))

# ─── Admin Logo ───
@app.route('/admin/logo')
@admin_required
def admin_logo():
    return render_template('admin/logo.html', logo_content=SiteContent.query.filter_by(key_name='logo_size').first())

@app.route('/admin/logo/update', methods=['POST'])
@admin_required
def admin_logo_update():
    for key in ['logo_dark','logo_light']:
        if key in request.files:
            f = request.files[key]
            if f and f.filename and allowed_file(f.filename):
                fn = key + '.' + f.filename.rsplit('.',1)[1].lower()
                f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
    sz = request.form.get('logo_size','35')
    sc = SiteContent.query.filter_by(key_name='logo_size').first()
    if not sc: sc = SiteContent(key_name='logo_size'); db.session.add(sc)
    sc.text_ar = sz; sc.text_en = sz
    db.session.commit(); flash('Updated','success')
    return redirect(url_for('admin_logo'))

if __name__ == '__main__':
    with app.app_context():
        db.create_all()
    app.run(debug=True, port=5000)
''')

