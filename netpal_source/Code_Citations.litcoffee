         'One Team. Four Superpowers. Boundless Creativity.'),
        ('about_text',
         'في NetPal لا نصنع تصاميم فحسب — بل نبني عوالم بصرية تخطف الأنظار وتُحرّك المشاعر. ندمج الفن بالتقنية والاستراتيجية لنقدم لك حلولاً متكاملة تضعك في صدارة المنافسة.',
         'At NetPal, we don\'t just create designs — we build visual worlds that captivate and move. We blend art, technology, and strategy to deliver integrated solutions that put you ahead of the competition.'),
        ('contact_whatsapp', '96100000000', '96100000000'),
        ('contact_email', 'hello@netpal.com', 'hello@netpal.com'),
        ('contact_title', 'جاهزون لتحويل رؤيتك إلى واقع', 'Ready to Turn Your Vision into Reality'),
        ('feat_1', 'تصميم مبني على هدف واستراتيجية', 'Purpose & Strategy-Driven Design'),
        ('feat_2', 'نظام عمل احترافي وسلس', 'Professional & Smooth Workflow'),
        ('feat_3', 'تسليم سريع بجودة لا تُضاهى', 'Fast Delivery with Unmatched Quality'),
    ]
    for k, ar, en in contents:
        db.session.add(SiteContent(key_name=k, text_ar=ar, text_en=en))

    # --- Team ---
    team = [
        ('أحمد','Ahmad','مدير إبداعي ومصمم جرافيك','Creative Director & Graphic Designer',
         'فوتوشوب,الستريتور,هويات بصرية,تصميم مطبوعات','Photoshop,Illustrator,Branding,Print Design'),
        ('سارة','Sarah','خبيرة موشن ومونتاج فيديو','Motion & Video Editing Expert',
         'أفتر افكتس,بريمير برو,تحريك,مونتاج','After Effects,Premiere Pro,Animation,Editing'),
        ('عمر','Omar','مهندس برمجيات ومطور','Software Engineer & Developer',
         'تطوير ويب,تصميم واجهات,قواعد بيانات,تطبيقات','Web Dev,UI/UX,Databases,Apps'),
        ('يارا','Yara','استراتيجية تسويق رقمي','Digital Marketing Strategist',
         'سوشيال ميديا,إعلانات مدفوعة,تحليل بيانات,محتوى','Social Media,Paid Ads,Analytics,Content'),
    ]
    for na,ne,ra,re,sa,se in team:
        db.session.add(TeamMember(name_ar=na,name_en=ne,role_ar=ra,role_en=re,skills_ar=sa,skills_en=se,image=''))

    # --- Sections & SubSections ---
    sec_data = [
        ('تصميم جرافيك', 'Graphic Design', 'graphic', [
            ('هويات بصرية','Visual Identity','identity'),
            ('سوشيال ميديا','Social Media','social'),
            ('لوغوهات','Logos','logos'),
            ('تصميم مطبوعات','Print Design','print'),
            ('تغليف ومنتجات','Packaging','packaging'),
        ]),
        ('موشن ومونتاج', 'Motion & Editing', 'motion', [
            ('موشن جرافيك','Motion Graphics','motion-graphics'),
            ('مونتاج فيديو','Video Editing','video-editing'),
            ('مقدمات وخواتم','Intro & Outro','intro-outro'),
            ('ريلز وشورتس','Reels & Shorts','reels'),
            ('تحريك ثلاثي الأبعاد','3D Animation','3d-animation'),
        ]),
        ('برمجة', 'Programming', 'programming', [
            ('تطوير مواقع','Web Development','web-dev'),
            ('تطبيقات موبايل','Mobile Apps','mobile-apps'),
            ('متاجر إلكترونية','E-Commerce','ecommerce'),
            ('لوحات تحكم','Dashboards & CMS','dashboards'),
