write_file('templates/project_detail.html', r'''{% extends "base.html" %}
{% block content %}
<section class="project-detail-hero">
    <div class="project-detail-cover">
        <img src="{{ project.cover }}" alt="Cover" onerror="this.src='/static/uploads/' + this.alt" id="detail-cover">
    </div>
    <div class="project-detail-overlay">
        <div class="container">
            <nav class="breadcrumb">
                <a href="/" data-i18n="nav_portfolio">أعمالنا</a>
                <span>/</span>
                <span class="bc-section" data-ar="{{ project.section_ar }}" data-en="{{ project.section_en }}">{{ project.section_ar }}</span>
                {% if project.sub_ar %}
                <span>/</span>
                <span class="bc-sub" data-ar="{{ project.sub_ar }}" data-en="{{ project.sub_en }}">{{ project.sub_ar }}</span>
                {% endif %}
            </nav>
        </div>
    </div>
</section>

<section class="project-detail-content container">
    <div class="project-detail-header">
        <h1 class="project-detail-title" data-ar="{{ project.title_ar }}" data-en="{{ project.title_en }}">{{ project.title_ar }}</h1>
        {% if project.tags %}
        <div class="project-detail-tags">
            {% for tag in project.tags %}<span class="skill-tag">{{ tag.strip() }}</span>{% endfor %}
        </div>
        {% endif %}
    </div>

    <div class="project-detail-desc" data-ar="{{ project.desc_ar }}" data-en="{{ project.desc_en }}">
        {{ project.desc_ar }}
    </div>

    {% if project.link %}
    <a href="{{ project.link }}" target="_blank" rel="noopener" class="btn btn-primary project-detail-link" data-i18n="site_visit">زيارة الموقع</a>
    {% endif %}

    {% if project.video %}
    <div class="project-detail-video">
        <video controls playsinline style="width:100%;border-radius:16px;">
            <source src="/static/uploads/{{ project.video }}" type="video/mp4">
        </video>
    </div>
    {% endif %}

    <div class="project-detail-gallery">
        <img src="{{ project.cover }}" alt="Project" class="project-real-image" onerror="this.src='/static/uploads/' + '{{ project.cover }}'">
        {% for img in project.images %}
        <img src="/static/uploads/{{ img }}" alt="Detail" class="project-real-image">
        {% endfor %}
    </div>
</section>

<script>
const pd = document.querySelector('.project-detail-content');
function updateDetailLang() {
    const lang = document.documentElement.lang || 'ar';
    document.querySelectorAll('[data-ar][data-en]').forEach(el => {
        const isHTML = el.tagName === 'DIV' || el.tagName === 'P';
        if (isHTML) el.innerHTML = el.dataset[lang] || el.dataset.ar;
        else el.textContent = el.dataset[lang] || el.dataset.ar;
    });
}
document.getElementById('lang-toggle')?.addEventListener('click', () => setTimeout(updateDetailLang, 50));
window.addEventListener('DOMContentLoaded', updateDetailLang);
</script>
{% endblock %}
''')

