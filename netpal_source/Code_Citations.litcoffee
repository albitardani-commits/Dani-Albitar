write_file('seed_db.py', r'''import os
from app import app, db, Admin, SiteContent, TeamMember, Project, ProjectImage, Section, SubSection
from werkzeug.security import generate_password_hash

with app.app_context():
    db.drop_all()
    db.create_all()

    # --- Admins ---
    db.session.add(Admin(username='admin', password_hash=generate_password_hash('netpal2026'), role='super_admin'))
    db.session.add(Admin(username='editor', password_hash=generate_password_hash('editor2026'), role='admin'))

    # --- Site Content ---
    contents = [
        ('hero_title',
         'نحن فريق NetPal — نُشكّل هُويّات بصرية تتحدث بلغة النجاح وتصنع الفارق',
         'We are NetPal — Forging visual identities that speak success and make the difference'),
