        ('about_text',
         'نحن في NetPal نؤمن بأن الإبداع ليس مجرد مظهر — بل هو لغة علامتك التجارية. نمزج الفن بالتقنية لنمنحك حلولاً بصرية وبرمجية تضعك في طليعة المنافسة، بأسلوب احترافي سريع وجودة استثنائية.',
         'At NetPal, we believe creativity is not just appearance — it is the voice of your brand. We blend art with technology to deliver visual and software solutions that put you ahead of the competition, with professional speed and exceptional quality.'),
        ('contact_whatsapp', '96100000000', '96100000000'),
        ('contact_email', 'hello@netpal.com', 'hello@netpal.com'),
        ('feat_1', 'تصميم مبني على رؤية وهدف واضح', 'Design Built on Vision and Clear Purpose'),
        ('feat_2', 'نظام عمل احترافي ومنظم', 'Professional and Organized Workflow'),
        ('feat_3', 'تسليم سريع بجودة استثنائية', 'Fast Delivery with Exceptional Quality'),
        ('contact_title', 'جاهزون لصناعة مشروعك القادم', 'Ready to Build Your Next Project'),
    ]
    for k, ar, en in contents:
        db.session.add(SiteContent(key_name=k, text_ar=ar, text_en=en))

    # ─── Team ───
    team = [
        ('أحمد','Ahmad','المدير الإبداعي وقائد التصميم','Creative Director & Lead Designer',
         'فوتوشوب,إلستريتور,هوية بصرية,تايبوغرافي','Photoshop,Illustrator,Branding,Typography'),
        ('سارة','Sarah','قائدة الموشن والمونتاج','Motion & Editing Lead',
         'أفتر إفكتس,بريمير برو,سينما فور دي,تحريك','After Effects,Premiere Pro,Cinema 4D,Animation'),
        ('عمر','Omar','رئيس قسم البرمجة','Head of Development',
         'تطوير ويب,تطبيقات,واجهات,قواعد بيانات','Web Dev,Mobile Apps,UI/UX,Databases'),
        ('يارا','Yara','مديرة التسويق الرقمي','Digital Marketing Manager',
         'سوشيال ميديا,إعلانات ممولة,تحليل بيانات,محتوى','Social Media,Paid Ads,Analytics,Content'),
    ]
    for na,ne,ra,re,sa,se in team:
        db.session.add(TeamMember(name_ar=na,name_en=ne,role_ar=ra,role_en=re,skills_ar=sa,skills_en=se,
                                  image='\u0644\u0648\u063a\u0648 \u0646\u064a\u062a\u0628\u0627\u0644 \u062c\u062f\u064a\u062f-0\u0661.png'))

    # ─── Sections ───
    sec_graphic = Section(name_ar='تصميم جرافيك', name_en='Graphic Design', slug='graphic', order_idx=0)
    sec_motion = Section(name_ar='موشن ومونتاج', name_en='Motion & Editing', slug='motion', order_idx=1)
    sec_prog = Section(name_ar='برمجة', name_en='Programming', slug='programming', order_idx=2)
    sec_market = Section(name_ar='تسويق رقمي', name_en='Digital Marketing', slug='marketing', order_idx=3)
    db.session.add_all([sec_graphic, sec_motion, sec_prog, sec_market])
    db.session.flush()

    # ─── SubSections ───
    # Graphic
    sub_identity = SubSection(section_id=sec_graphic.id, name_ar='هويات بصرية', name_en='Visual Identity', slug='identity', order_idx=0)
    sub_social = SubSection(section_id=sec_graphic.id, name_ar='سوشيال ميديا', name_en='Social Media', slug='social', order_idx=1)
    sub_logos = SubSection(section_id=sec_graphic.id, name_ar='لوغوهات', name_en='Logos', slug='logos', order_idx=2)
    sub_print = SubSection(section_id=sec_graphic.id, name_ar='مطبوعات', name_en='Print Design', slug='print', order_idx=3)
    sub_packaging = SubSection(section_id=sec_graphic.id, name_ar='تغليف', name_en='Packaging', slug='packaging', order_idx=4)
    # Motion
