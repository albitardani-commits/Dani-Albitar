         'sid':sec_motion.id,'subid':sub_intros.id,'cover':imgs['intro1']},
        {'ta':'مقدمة سلسلة تعليمية','te':'Course Series Intro',
         'da':'مقدمة احترافية لسلسلة دورات تعليمية أونلاين.',
         'de':'Professional intro for an online educational course series.',
         'sid':sec_motion.id,'subid':sub_intros.id,'cover':imgs['motion2']},

        # ── Motion > Reels ──
        {'ta':'ريل إعلاني لمنتج','te':'Product Ad Reel',
         'da':'فيديو ريل قصير 15 ثانية لعرض منتج جديد بطريقة جذابة.',
