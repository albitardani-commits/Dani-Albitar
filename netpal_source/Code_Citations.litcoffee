# static/js/app.js
# ============================================================
write_file('static/js/app.js', r'''const state = { lang: 'ar', theme: 'dark' };
const langBtn = document.getElementById('lang-toggle');
const themeBtn = document.getElementById('theme-toggle');
const rootHtml = document.documentElement;
const body = document.body;

document.addEventListener('DOMContentLoaded', () => {
    initPreloader();
    initTheme();
    initLang();
    initCursor();
    initThreeJS();
    initGSAP();
    initPortfolio();
});

function initPreloader() {
    setTimeout(() => {
        gsap.to('#preloader', {
            opacity: 0, duration: 1,
            onComplete: () => {
                document.getElementById('preloader').style.display = 'none';
                animateHero();
            }
        });
    }, 2800);
}

function initCursor() {
    const cursor = document.getElementById('custom-cursor');
    const trail = document.getElementById('cursor-trail');
    if (!cursor || !trail) return;
    window.addEventListener('mousemove', (e) => {
        gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0 });
        gsap.to(trail, { x: e.clientX, y: e.clientY, duration: 0.15, ease: 'power2.out' });
    });
    document.querySelectorAll('a, button, .project-card, .team-member').forEach(el => {
        el.addEventListener('mouseenter', () => body.classList.add('hovering'));
        el.addEventListener('mouseleave', () => body.classList.remove('hovering'));
    });
}

function initTheme() {
    const iconMoon = document.querySelector('.icon-moon');
    const iconSun = document.querySelector('.icon-sun');
    if (!themeBtn) return;
    themeBtn.addEventListener('click', () => {
        if (state.theme === 'dark') {
            body.classList.replace('theme-dark', 'theme-light');
            if (iconMoon) iconMoon.classList.add('hidden');
            if (iconSun) iconSun.classList.remove('hidden');
            state.theme = 'light';
        } else {
            body.classList.replace('theme-light', 'theme-dark');
            if (iconSun) iconSun.classList.add('hidden');
            if (iconMoon) iconMoon.classList.remove('hidden');
            state.theme = 'dark';
        }
        updateThreeJSColor();
    });
}

function initLang() {
    if (!langBtn) return;
    langBtn.addEventListener('click', () => {
        state.lang = state.lang === 'ar' ? 'en' : 'ar';
        langBtn.textContent = state.lang === 'ar' ? 'EN' : 'عربي';
        rootHtml.setAttribute('dir', state.lang === 'ar' ? 'rtl' : 'ltr');
        rootHtml.setAttribute('lang', state.lang);
        updateContent();
    });
    updateContent();
}

function updateContent() {
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (window.SITE_CONTENT && window.SITE_CONTENT[key]) {
            let html = window.SITE_CONTENT[key][state.lang] || '';
            html = html.replace(/NetPal/g, '<span dir="ltr" style="display:inline-block;">NetPal</span>');
            el.innerHTML = html;
        }
    });
    if (window.TEAM_DATA) renderTeam();
    if (window.PROJECTS_DATA) renderProjects();
}

function renderTeam() {
    const container = document.getElementById('team-container');
    if (!container || !window.TEAM_DATA) return;
    container.innerHTML = '';
    window.TEAM_DATA.forEach(t => {
        const name = state.lang === 'ar' ? t.name_ar : t.name_en;
        const role = state.lang === 'ar' ? t.role_ar : t.role_en;
        const skills = state.lang === 'ar' ? t.skills_ar : t.skills_en;
        const imgSrc = t.image ? `/static/uploads/${t.image}` : `/static/images/لوغو نيتبال جديد-0١.png`;
        container.innerHTML += `
        <div class="team-member">
            <div class="team-card-inner">
                <div class="team-front">
                    <div class="team-img-wrap"><img src="${imgSrc}" alt="${name}" onerror="this.src='/static/images/لوغو نيتبال جديد-0١.png'"></div>
                    <div class="team-name">${name}</div>
                    <div class="team-role">${role}</div>
                </div>
                <div class="team-back">
                    <div class="team-name" style="margin-bottom:15px;">${name}</div>
                    <div class="team-skills">${skills.map(s => `<span class="skill-tag">${s.trim()}</span>`).join('')}</div>
                </div>
            </div>
        </div>`;
    });
}

// Portfolio
let currentSection = null;
let currentSubSection = null;

function initPortfolio() {
    if (!window.SECTIONS_DATA || !window.SECTIONS_DATA.length) return;
    const tabsContainer = document.getElementById('portfolio-tabs');
    const subsContainer = document.getElementById('portfolio-subs');
    if (!tabsContainer) return;

    currentSection = window.SECTIONS_DATA[0];
    currentSubSection = currentSection.sub_sections.length ? currentSection.sub_sections[0] : null;

    renderTabs();
    renderSubs();
    renderProjects();
}

function renderTabs() {
    const tabsContainer = document.getElementById('portfolio-tabs');
    if (!tabsContainer) return;
    tabsContainer.innerHTML = '';
    window.SECTIONS_DATA.forEach((sec, idx) => {
        const name = state.lang === 'ar' ? sec.name_ar : sec.name_en;
        const btn = document.createElement('button');
        btn.className = 'tab-btn' + (currentSection && currentSection.slug === sec.slug ? ' active' : '');
        btn.textContent = name;
        btn.addEventListener('click', () => {
            currentSection = sec;
            currentSubSection = sec.sub_sections.length ? sec.sub_sections[0] : null;
            renderTabs();
            renderSubs();
            renderProjects();
        });
        tabsContainer.appendChild(btn);
    });
}

function renderSubs() {
    const subsContainer = document.getElementById('portfolio-subs');
    if (!subsContainer) return;
    subsContainer.innerHTML = '';
    if (!currentSection || !currentSection.sub_sections.length) {
        subsContainer.style.display = 'none';
        return;
    }
    subsContainer.style.display = 'flex';
    currentSection.sub_sections.forEach(sub => {
        const name = state.lang === 'ar' ? sub.name_ar : sub.name_en;
        const btn = document.createElement('button');
        btn.className = 'sub-tab' + (currentSubSection && currentSubSection.slug === sub.slug ? ' active' : '');
        btn.textContent = name;
        btn.addEventListener('click', () => {
            currentSubSection = sub;
            renderSubs();
            renderProjects();
        });
        subsContainer.appendChild(btn);
    });
}

function renderProjects() {
    const container = document.getElementById('projects-container');
    if (!container || !window.PROJECTS_DATA) return;
    container.innerHTML = '';

    const filtered = window.PROJECTS_DATA.filter(p => {
        if (!currentSection) return false;
        if (p.section_slug !== currentSection.slug) return false;
        if (currentSection.sub_sections.length && currentSubSection) {
            if (p.sub_section_slug !== currentSubSection.slug) return false;
        }
        return true;
    });

    if (!filtered.length) {
        container.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--text-muted);opacity:0.5;padding:60px 0;">
            ${state.lang === 'ar' ? 'لا توجد مشاريع بعد' : 'No projects yet'}</p>`;
        return;
    }

    filtered.forEach(p => {
        const title = state.lang === 'ar' ? p.title_ar : p.title_en;
        const subName = currentSubSection ? (state.lang === 'ar' ? currentSubSection.name_ar : currentSubSection.name_en) : '';
        const card = document.createElement('a');
        card.href = `/project/${p.id}`;
        card.className = 'project-card';
        card.style.textDecoration = 'none';
        card.innerHTML = `
            <img src="${p.cover}" alt="${title}" onerror="this.src='/static/uploads/${p.cover}'">
            <div class="project-overlay">
                <div class="project-title">${title}</div>
                <div class="project-cat">${subName}</div>
            </div>`;
        card.addEventListener('mouseenter', () => body.classList.add('project-hover'));
        card.addEventListener('mouseleave', () => body.classList.remove('project-hover'));
        container.appendChild(card);
    });

    initCursor();
    gsap.from('.project-card', { y: 40, opacity: 0, duration: 0.8, stagger: 0.08, ease: 'power3.out' });
}

// Three.js
let scene, camera, renderer, particles, infinityGroup;

function initThreeJS() {
    const container = document.getElementById('three-canvas-container');
    if (!container) return;
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 1, 3000);
    camera.position.z = 1200;
    renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    // Particles
    const geo = new THREE.BufferGeometry();
    const verts = [];
    for (let i = 0; i < 4000; i++) {
        verts.push((Math.random()-0.5)*3000, (Math.random()-0.5)*3000, (Math.random()-0.5)*3000);
    }
    geo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));

    const canvas2d = document.createElement('canvas');
    canvas2d.width = 32; canvas2d.height = 32;
    const ctx = canvas2d.getContext('2d');
    const grad = ctx.createRadialGradient(16,16,0,16,16,16);
    grad.addColorStop(0,'rgba(255,255,255,1)');
    grad.addColorStop(0.2,'rgba(255,255,255,0.8)');
    grad.addColorStop(0.5,'rgba(255,255,255,0.2)');
    grad.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,32,32);
    const tex = new THREE.CanvasTexture(canvas2d);

    const color = state.theme === 'dark' ? 0x5DCBCA : 0x07444E;
    const mat = new THREE.PointsMaterial({ size:15, color, map:tex, blending:THREE.AdditiveBlending, depthWrite:false, transparent:true, opacity:0.4 });
    particles = new THREE.Points(geo, mat);
    scene.add(particles);

    // Infinity
    infinityGroup = new THREE.Group();
    const pts = [];
    for(let i=0;i<=200;i++){
        const t=i/200*Math.PI*2;
        const x=(800*Math.cos(t))/(1+Math.sin(t)**2);
        const y=(800*Math.sin(t)*Math.cos(t))/(1+Math.sin(t)**2);
        pts.push(new THREE.Vector3(x,y,0));
    }
    const infGeo = new THREE.BufferGeometry().setFromPoints(pts);
    const infMat = new THREE.LineBasicMaterial({color,transparent:true,opacity:0.15});
    for(let j=0;j<5;j++){
        const line = new THREE.Line(infGeo,infMat.clone());
        line.scale.setScalar(1-j*0.05);
        line.rotation.z=(Math.PI/180)*(j*2);
        infinityGroup.add(line);
    }
    scene.add(infinityGroup);

    let mouseX=0,mouseY=0,targetX=0,targetY=0;
    const hw=window.innerWidth/2, hh=window.innerHeight/2;
    document.addEventListener('mousemove',e=>{targetX=(e.clientX-hw)*0.5;targetY=(e.clientY-hh)*0.5;});
    window.addEventListener('resize',()=>{camera.aspect=window.innerWidth/window.innerHeight;camera.updateProjectionMatrix();renderer.setSize(window.innerWidth,window.innerHeight);});

    const clock = new THREE.Clock();
