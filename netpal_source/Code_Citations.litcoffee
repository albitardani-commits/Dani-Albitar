    db.session.add(Admin(username='admin', password_hash=generate_password_hash('netpal2026'), role='admin'))

    # ─── Site Content ───
    contents = [
        ('hero_title',
         'نحن فريق NetPal — نصنع الإبداع البصري الذي يخطف الأبصار ويترك بصمة لا تُنسى',
