    if s:
        s.name_ar = request.form.get('name_ar',s.name_ar).strip()
        s.name_en = request.form.get('name_en',s.name_en).strip()
        db.session.commit()
        flash('Updated','success')
    return redirect(url_for('admin_sections'))

@app.route('/admin/sections/<int:sid>/delete', methods=['POST'])
@admin_required
def admin_sections_delete(sid):
