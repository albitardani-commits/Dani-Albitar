        db.session.add(sec)
        db.session.flush()
        section_objs[sl] = sec
        for sidx, (sna, sne, ssl) in enumerate(subs):
            sub = SubSection(section_id=sec.id, name_ar=sna, name_en=sne, slug=ssl, order_idx=sidx)
            db.session.add(sub)
            db.session.flush()
            sub_objs[f'{sl}/{ssl}'] = sub

    # --- Projects (lots of dummy data) ---
    # Unsplash placeholder images by category
    img = {
        'brand': 'https://images.unsplash.com/photo-1599420186716-43bba1ebbc9c?w=800&q=80',
        'social': 'https://images.unsplash.com/photo-1611162617213-7d7a39e9b1d7?w=800&q=80',
