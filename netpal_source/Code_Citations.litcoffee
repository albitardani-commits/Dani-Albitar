        ('about_text',
         'نحن في NetPal نؤمن بأن الإبداع ليس مجرد مظهر — بل هو لغة علامتك التجارية. نمزج الفن بالتقنية لنمنحك حلولاً بصرية وبرمجية تضعك في طليعة المنافسة، بأسلوب احترافي سريع وجودة استثنائية.',
         'At NetPal, we believe creativity is not just appearance — it is the voice of your brand. We blend art with technology to deliver visual and software solutions that put you ahead of the competition, with professional speed and exceptional quality.'),
        ('contact_whatsapp', '96100000000', '96100000000'),
        ('contact_email', 'hello@netpal.com', 'hello@netpal.com'),
        ('feat_1', 'تصميم مبني على رؤية وهدف واضح', 'Design Built on Vision and Clear Purpose'),
        ('feat_2', 'نظام عمل احترافي ومنظم', 'Professional and Organized Workflow'),
        ('feat_3', 'تسليم سريع بجودة استثنائية', 'Fast Delivery with Exceptional Quality'),
        ('contact_title', 'جاهزون لصناعة مشروعك القادم', 'Ready to Build Your Next Project'),
    ]
    for k, ar, en in contents:
        db.session.add(SiteContent(key_name=k, text_ar=ar, text_en=en))

    # ─── Team ───
