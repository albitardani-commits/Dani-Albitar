    sub_editing = SubSection(section_id=sec_motion.id, name_ar='مونتاج فيديو', name_en='Video Editing', slug='editing', order_idx=1)
    sub_intros = SubSection(section_id=sec_motion.id, name_ar='مقدمات وخواتم', name_en='Intros & Outros', slug='intros', order_idx=2)
    sub_reels = SubSection(section_id=sec_motion.id, name_ar='ريلز وشورتس', name_en='Reels & Shorts', slug='reels', order_idx=3)
    sub_3d = SubSection(section_id=sec_motion.id, name_ar='تحريك ثلاثي الأبعاد', name_en='3D Animation', slug='3d-animation', order_idx=4)
    # Programming
