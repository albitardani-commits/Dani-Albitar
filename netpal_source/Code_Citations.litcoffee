        'intro': 'https://images.unsplash.com/photo-1536240478700-b869070f9279?w=800&q=80',
        'reel': 'https://images.unsplash.com/photo-1611162616475-46b635cb6868?w=800&q=80',
        '3d': 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=800&q=80',
        'web': 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=800&q=80',
        'app': 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&q=80',
        'shop': 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80',
        'dash': 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&q=80',
        'smm': 'https://images.unsplash.com/photo-1432888498266-38ffec3eaf0a?w=800&q=80',
        'ads': 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80',
        'seo': 'https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?w=800&q=80',
    }

