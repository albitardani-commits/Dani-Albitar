        'brand1': 'https://images.unsplash.com/photo-1555529902-5261145633ec?w=800&q=80',
        'brand2': 'https://images.unsplash.com/photo-1599420186716-43bba1ebbc9c?w=800&q=80',
        'brand3': 'https://images.unsplash.com/photo-1634942537034-2531766767d1?w=800&q=80',
