         'sid':sec_market.id,'subid':sub_smm.id,'cover':imgs['smm2']},
        {'ta':'إدارة سوشيال عيادة','te':'Medical Clinic Social Media',
         'da':'إدارة محتوى وسائل التواصل لعيادة طبية مع استراتيجية تفاعل فعالة.',
         'de':'Social media content management for a medical clinic with effective engagement strategy.',
         'sid':sec_market.id,'subid':sub_smm.id,'cover':imgs['smm1']},

        # ── Marketing > SEO ──
        {'ta':'تحسين SEO لمتجر إلكتروني','te':'E-Commerce SEO Optimization',
