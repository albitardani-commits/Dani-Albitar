# --- Projects CRUD ---
@app.route('/admin/projects')
@admin_required
def admin_projects():
    ss = request.args.get('section','')
    secs = Section.query.order_by(Section.order_idx).all()
    if ss:
        sec = Section.query.filter_by(slug=ss).first()
        projs = Project.query.filter_by(section_id=sec.id).order_by(Project.order_idx).all() if sec else []
    else:
        projs = Project.query.order_by(Project.order_idx).all()
    return render_template('admin/projects.html', projects=projs, sections=secs, current_section=ss)

@app.route('/admin/projects/add', methods=['GET','POST'])
@admin_required
def admin_projects_add():
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        ta,te = request.form.get('title_ar','').strip(),request.form.get('title_en','').strip()
        da,de = request.form.get('description_ar','').strip(),request.form.get('description_en','').strip()
        sid = request.form.get('section_id',type=int)
        subid = request.form.get('sub_section_id',type=int) or None
        cover = ''
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename)
                f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
                cover = fn
        if not cover:
            cover = request.form.get('cover_url','').strip()
        if ta and te and sid and cover:
            p = Project(title_ar=ta,title_en=te,description_ar=da,description_en=de,
                section_id=sid,sub_section_id=subid,cover_image=cover,
                video_url=request.form.get('video_url','').strip() or None,
                link_url=request.form.get('link_url','').strip() or None,
                tech_tags=request.form.get('tech_tags','').strip() or None,
                order_idx=Project.query.count())
            db.session.add(p); db.session.commit()
            flash('Project added','success')
            return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs,
        subs=SubSection.query.all(), project=None)

@app.route('/admin/projects/<int:pid>/edit', methods=['GET','POST'])
@admin_required
def admin_projects_edit(pid):
    proj = db.session.get(Project, pid)
    if not proj: abort(404)
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        proj.title_ar = request.form.get('title_ar',proj.title_ar).strip()
        proj.title_en = request.form.get('title_en',proj.title_en).strip()
        proj.description_ar = request.form.get('description_ar','').strip()
        proj.description_en = request.form.get('description_en','').strip()
        proj.section_id = request.form.get('section_id',type=int) or proj.section_id
        proj.sub_section_id = request.form.get('sub_section_id',type=int) or None
        proj.video_url = request.form.get('video_url','').strip() or None
        proj.link_url = request.form.get('link_url','').strip() or None
        proj.tech_tags = request.form.get('tech_tags','').strip() or None
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename)
                f.save(os.path.join(app.config['UPLOAD_FOLDER'], fn))
                proj.cover_image = fn
        cu = request.form.get('cover_url','').strip()
        if cu: proj.cover_image = cu
        db.session.commit()
        flash('Updated','success')
        return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs,
        subs=SubSection.query.all(), project=proj)

@app.route('/admin/projects/<int:pid>/delete', methods=['POST'])
@admin_required
def admin_projects_delete(pid):
    p = db.session.get(Project, pid)
    if p: db.session.delete(p); db.session.commit(); flash('Deleted','success')
    return redirect(url_for('admin_projects'))

