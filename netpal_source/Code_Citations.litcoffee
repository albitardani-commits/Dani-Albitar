# ─── Admin Projects ───
@app.route('/admin/projects')
@admin_required
def admin_projects():
    sec_slug = request.args.get('section','')
    secs = Section.query.order_by(Section.order_idx).all()
    if sec_slug:
        sec = Section.query.filter_by(slug=sec_slug).first()
        projs = Project.query.filter_by(section_id=sec.id).order_by(Project.order_idx).all() if sec else []
    else:
        projs = Project.query.order_by(Project.order_idx).all()
    return render_template('admin/projects.html', projects=projs, sections=secs, current_section=sec_slug)

@app.route('/admin/projects/add', methods=['GET','POST'])
@admin_required
def admin_projects_add():
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        ta,te = request.form.get('title_ar','').strip(), request.form.get('title_en','').strip()
        da,de = request.form.get('description_ar','').strip(), request.form.get('description_en','').strip()
        sid = request.form.get('section_id', type=int)
        subid = request.form.get('sub_section_id', type=int) or None
        vid,lnk,tags = request.form.get('video_url','').strip(), request.form.get('link_url','').strip(), request.form.get('tech_tags','').strip()
        cover = request.form.get('cover_url','').strip()
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); cover = fn
        if ta and te and sid and cover:
            p = Project(title_ar=ta,title_en=te,description_ar=da,description_en=de,
                section_id=sid,sub_section_id=subid,cover_image=cover,
                video_url=vid or None,link_url=lnk or None,tech_tags=tags or None,
                order_idx=Project.query.count())
            db.session.add(p); db.session.commit()
            if 'project_images' in request.files:
                for i,fi in enumerate(request.files.getlist('project_images')):
                    if fi and fi.filename and allowed_file(fi.filename):
                        fn = secure_filename(fi.filename); fi.save(os.path.join(app.config['UPLOAD_FOLDER'],fn))
                        db.session.add(ProjectImage(project_id=p.id,image_path=fn,order_idx=i))
                db.session.commit()
            flash('Project added','success'); return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs, subs=SubSection.query.all(), project=None)

@app.route('/admin/projects/<int:pid>/edit', methods=['GET','POST'])
@admin_required
def admin_projects_edit(pid):
    p = db.session.get(Project, pid)
    if not p: abort(404)
    secs = Section.query.order_by(Section.order_idx).all()
    if request.method == 'POST':
        p.title_ar = request.form.get('title_ar', p.title_ar).strip()
        p.title_en = request.form.get('title_en', p.title_en).strip()
        p.description_ar = request.form.get('description_ar','').strip()
        p.description_en = request.form.get('description_en','').strip()
        p.section_id = request.form.get('section_id', type=int) or p.section_id
        p.sub_section_id = request.form.get('sub_section_id', type=int) or None
        p.video_url = request.form.get('video_url','').strip() or None
        p.link_url = request.form.get('link_url','').strip() or None
        p.tech_tags = request.form.get('tech_tags','').strip() or None
        cu = request.form.get('cover_url','').strip()
        if cu: p.cover_image = cu
        if 'cover_image' in request.files:
            f = request.files['cover_image']
            if f and f.filename and allowed_file(f.filename):
                fn = secure_filename(f.filename); f.save(os.path.join(app.config['UPLOAD_FOLDER'],fn)); p.cover_image = fn
        db.session.commit(); flash('Updated','success'); return redirect(url_for('admin_projects'))
    return render_template('admin/project_form.html', sections=secs, subs=SubSection.query.all(), project=p)

@app.route('/admin/projects/<int:pid>/delete', methods=['POST'])
@admin_required
def admin_projects_delete(pid):
