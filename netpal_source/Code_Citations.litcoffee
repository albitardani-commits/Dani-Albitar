        ('تحسين SEO لمتجر إلكتروني','E-Commerce SEO','تحسين ترتيب متجر إلكتروني في نتائج البحث.','Improving e-commerce store search engine rankings.','marketing','seo',img['seo']),
    ]

    for idx, pdata in enumerate(projects_data):
        ta,te,da,de,sec_slug,sub_slug,cover = pdata[:7]
        tags = pdata[7] if len(pdata) > 7 else None
        sec = section_objs[sec_slug]
        sub = sub_objs.get(f'{sec_slug}/{sub_slug}')
        p = Project(
            title_ar=ta, title_en=te, description_ar=da, description_en=de,
            section_id=sec.id, sub_section_id=sub.id if sub else None,
            cover_image=cover, tech_tags=tags, order_idx=idx
        )
        db.session.add(p)

    db.session.commit()
    print(f"Database seeded! {Project.query.count()} projects, {Section.query.count()} sections created.")
''')

# ============================================================
# templates/base.html
# ============================================================
write_file('templates/base.html', r'''<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetPal Portfolio</title>
    <meta name="description" content="NetPal — Creative Digital Agency">
    <meta name="theme-color" content="#07444E">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
</head>
<body class="theme-dark">
    <div id="custom-cursor"></div>
    <div id="cursor-trail"></div>

    <div id="preloader">
        <div class="preloader-logo-wrap">
            <svg class="preloader-svg" viewBox="0 0 200 200" width="150" height="150">
                <circle class="draw-circle" cx="100" cy="100" r="90" fill="none" stroke="var(--primary)" stroke-width="2"/>
                <text x="100" y="110" text-anchor="middle" fill="var(--primary)" font-size="28" font-family="Co Headline" font-weight="700" opacity="0" class="preloader-text">NetPal</text>
            </svg>
        </div>
    </div>

    <nav class="floating-nav">
        <a href="/" class="nav-logo">
            <img src="{{ url_for('static', filename='images/' + '\u0644\u0648\u063a\u0648 \u0646\u064a\u062a\u0628\u0627\u0644 \u062c\u062f\u064a\u062f-0\u0661.svg') }}" alt="NetPal" class="nav-logo-img" id="nav-logo-img">
        </a>
        <div class="nav-links">
            <a href="/#about" data-i18n="nav_about">من نحن</a>
            <a href="/#portfolio" data-i18n="nav_portfolio">أعمالنا</a>
            <a href="/#contact" data-i18n="nav_contact">تواصل معنا</a>
        </div>
        <div class="nav-controls">
            <button id="lang-toggle" aria-label="Toggle Language" class="nav-btn">EN</button>
            <button id="theme-toggle" aria-label="Toggle Theme" class="nav-btn">
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                <svg class="icon-sun hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </button>
        </div>
    </nav>

    <div id="smooth-wrapper">
        <div id="smooth-content">
            {% block content %}{% endblock %}
            <footer class="site-footer">
                <div class="footer-content container">
                    <img src="{{ url_for('static', filename='images/' + '\u0644\u0648\u063a\u0648 \u0646\u064a\u062a\u0628\u0627\u0644 \u062c\u062f\u064a\u062f-0\u0661.svg') }}" alt="NetPal" class="footer-logo">
                    <p class="footer-madeby" data-i18n="footer_copy">جميع الحقوق محفوظة &copy; NetPal 2026</p>
                </div>
            </footer>
        </div>
    </div>

    <script>
        window.SITE_CONTENT = {{ content | tojson | safe }};
        window.SECTIONS_DATA = {{ sections | tojson | safe }};
        {% if projects is defined %}window.PROJECTS_DATA = {{ projects | tojson | safe }};{% else %}window.PROJECTS_DATA = [];{% endif %}
        {% if team is defined %}window.TEAM_DATA = {{ team | tojson | safe }};{% else %}window.TEAM_DATA = [];{% endif %}
    </script>
    <script src="{{ url_for('static', filename='js/app.js') }}"></script>
</body>
</html>
''')

# ============================================================
# templates/index.html
# ============================================================
write_file('templates/index.html', r'''{% extends "base.html" %}
{% block content %}
<section class="hero" id="hero">
    <div id="three-canvas-container"></div>
    <div class="hero-logo-container" id="hero-logo-container">
        <img src="{{ url_for('static', filename='images/' + '\u0644\u0648\u063a\u0648 \u0646\u064a\u062a\u0628\u0627\u0644 \u062c\u062f\u064a\u062f-0\u0661.svg') }}" alt="NetPal" class="hero-main-logo" id="heroLogo">
    </div>
    <div class="hero-content">
        <h1 class="hero-title" data-i18n="hero_title"></h1>
        <p class="hero-subtitle" data-i18n="hero_subtitle"></p>
        <div class="hero-cta">
            <a href="#portfolio" class="btn btn-primary" data-i18n="cta_portfolio">شوف أعمالنا</a>
            <a href="#contact" class="btn btn-outline" data-i18n="cta_contact">تواصل معنا</a>
        </div>
    </div>
    <div class="scroll-indicator">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </div>
</section>

<section id="about" class="container">
    <div class="section-header">
        <h2 class="section-title" data-i18n="nav_about">من نحن</h2>
        <div class="section-line"></div>
    </div>
    <div class="about-grid">
        <div class="about-text">
            <h3 data-i18n="about_title"></h3>
            <p data-i18n="about_text"></p>
            <ul class="about-features">
                <li data-i18n="feat_1">تصميم مبني على هدف</li>
                <li data-i18n="feat_2">نظام عمل احترافي</li>
                <li data-i18n="feat_3">تسليم سريع بجودة عالية</li>
            </ul>
        </div>
        <div class="team-grid" id="team-container"></div>
    </div>
</section>

<section id="portfolio" class="container">
    <div class="section-header">
        <h2 class="section-title" data-i18n="nav_portfolio">أعمالنا</h2>
        <div class="section-line"></div>
    </div>
    <div class="portfolio-tabs" id="portfolio-tabs"></div>
    <div class="portfolio-subcategories" id="portfolio-subs"></div>
    <div class="projects-grid" id="projects-container"></div>
</section>

<section id="contact" class="container contact-section">
    <div class="contact-bg"></div>
    <div class="section-header">
        <h2 class="section-title" data-i18n="contact_title">جاهزون للمشروع الجاي</h2>
        <div class="section-line"></div>
    </div>
    <div class="contact-actions">
        <a href="https://wa.me/{{ content.contact_whatsapp.ar if content.contact_whatsapp is defined else '' }}" target="_blank" class="contact-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <span data-i18n="btn_whatsapp">واتساب</span>
        </a>
        <a href="mailto:{{ content.contact_email.ar if content.contact_email is defined else '' }}" class="contact-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
            <span data-i18n="btn_email">إيميل</span>
        </a>
    </div>
</section>

<script>
Object.assign(window.SITE_CONTENT, {
    nav_about: {ar:'من نحن', en:'About Us'},
    nav_portfolio: {ar:'أعمالنا', en:'Portfolio'},
    nav_contact: {ar:'تواصل معنا', en:'Contact'},
    cta_portfolio: {ar:'شوف أعمالنا', en:'See Our Work'},
    cta_contact: {ar:'تواصل معنا', en:'Contact Us'},
    btn_whatsapp: {ar:'واتساب', en:'WhatsApp'},
    btn_email: {ar:'إيميل', en:'Email'},
    footer_copy: {ar:'جميع الحقوق محفوظة &copy; NetPal 2026', en:'All Rights Reserved &copy; NetPal 2026'},
    site_visit: {ar:'زيارة الموقع', en:'Visit Website'},
    view_project: {ar:'عرض المشروع', en:'View Project'},
});
</script>
{% endblock %}
''')

# ============================================================
# templates/project_detail.html
# ============================================================
write_file('templates/project_detail.html', r'''{% extends "base.html" %}
{% block content %}
<section class="project-detail-hero">
    <div class="project-detail-cover">
        <img src="{{ project.cover }}" alt="Cover" onerror="this.src='/static/uploads/' + this.alt" id="detail-cover">
    </div>
    <div class="project-detail-overlay">
        <div class="container">
            <nav class="breadcrumb">
                <a href="/" data-i18n="nav_portfolio">أعمالنا</a>
                <span>/</span>
                <span class="bc-section" data-ar="{{ project.section_ar }}" data-en="{{ project.section_en }}">{{ project.section_ar }}</span>
                {% if project.sub_ar %}
                <span>/</span>
                <span class="bc-sub" data-ar="{{ project.sub_ar }}" data-en="{{ project.sub_en }}">{{ project.sub_ar }}</span>
                {% endif %}
            </nav>
        </div>
    </div>
</section>

<section class="project-detail-content container">
    <div class="project-detail-header">
        <h1 class="project-detail-title" data-ar="{{ project.title_ar }}" data-en="{{ project.title_en }}">{{ project.title_ar }}</h1>
        {% if project.tags %}
        <div class="project-detail-tags">
            {% for tag in project.tags %}<span class="skill-tag">{{ tag.strip() }}</span>{% endfor %}
        </div>
        {% endif %}
    </div>

    <div class="project-detail-desc" data-ar="{{ project.desc_ar }}" data-en="{{ project.desc_en }}">
        {{ project.desc_ar }}
    </div>

    {% if project.link %}
    <a href="{{ project.link }}" target="_blank" rel="noopener" class="btn btn-primary project-detail-link" data-i18n="site_visit">زيارة الموقع</a>
    {% endif %}

    {% if project.video %}
    <div class="project-detail-video">
        <video controls playsinline style="width:100%;border-radius:16px;">
            <source src="/static/uploads/{{ project.video }}" type="video/mp4">
        </video>
    </div>
    {% endif %}

    <div class="project-detail-gallery">
        <img src="{{ project.cover }}" alt="Project" class="project-real-image" onerror="this.src='/static/uploads/' + '{{ project.cover }}'">
        {% for img in project.images %}
        <img src="/static/uploads/{{ img }}" alt="Detail" class="project-real-image">
        {% endfor %}
    </div>
</section>

<script>
const pd = document.querySelector('.project-detail-content');
function updateDetailLang() {
    const lang = document.documentElement.lang || 'ar';
    document.querySelectorAll('[data-ar][data-en]').forEach(el => {
        const isHTML = el.tagName === 'DIV' || el.tagName === 'P';
        if (isHTML) el.innerHTML = el.dataset[lang] || el.dataset.ar;
        else el.textContent = el.dataset[lang] || el.dataset.ar;
    });
}
document.getElementById('lang-toggle')?.addEventListener('click', () => setTimeout(updateDetailLang, 50));
window.addEventListener('DOMContentLoaded', updateDetailLang);
</script>
{% endblock %}
''')

# ============================================================
# templates/admin/login.html
# ============================================================
write_file('templates/admin/login.html', r'''<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetPal Admin - Login</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <style>
        body { display:flex; justify-content:center; align-items:center; min-height:100vh; cursor:auto; }
        .login-box { background:var(--card-bg); border:1px solid var(--border-color); border-radius:24px; padding:50px 40px; width:100%; max-width:400px; backdrop-filter:blur(20px); }
        .login-box h1 { color:var(--primary); font-size:2rem; text-align:center; margin-bottom:30px; }
        .login-box input { width:100%; padding:14px 20px; border-radius:12px; border:1px solid var(--border-color); background:rgba(255,255,255,0.05); color:var(--text-color); font-family:inherit; font-size:1rem; margin-bottom:16px; outline:none; }
        .login-box input:focus { border-color:var(--primary); }
        .login-box button { width:100%; padding:14px; border-radius:12px; background:var(--primary); color:#000; font-weight:700; font-size:1.1rem; border:none; cursor:pointer; transition:0.3s; }
        .login-box button:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(93,203,202,0.3); }
        .flash-msg { background:rgba(255,0,0,0.1); border:1px solid rgba(255,0,0,0.3); padding:10px; border-radius:8px; margin-bottom:16px; text-align:center; color:#ff6b6b; }
        a { text-decoration:none; }
    </style>
</head>
<body class="theme-dark">
    <div class="login-box">
        <h1>NetPal Admin</h1>
        {% with messages = get_flashed_messages() %}
        {% if messages %}<div class="flash-msg">{{ messages[0] }}</div>{% endif %}
        {% endwith %}
        <form method="POST">
            <input type="text" name="username" placeholder="Username" required autocomplete="username">
            <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>
''')

# ============================================================
# templates/admin/base.html (Admin Layout)
# ============================================================
write_file('templates/admin/base.html', r'''<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetPal Admin</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <style>
        body { cursor:auto; display:flex; min-height:100vh; }
        a, button { cursor:pointer; }
        .admin-sidebar {
            width:260px; min-height:100vh; background:var(--card-bg); border-inline-end:1px solid var(--border-color);
            padding:20px 0; position:fixed; top:0; inset-inline-start:0; z-index:100; backdrop-filter:blur(20px);
            overflow-y:auto;
        }
        .admin-sidebar .logo { text-align:center; padding:20px; margin-bottom:20px; border-bottom:1px solid var(--border-color); }
        .admin-sidebar .logo h2 { color:var(--primary); font-size:1.4rem; }
        .admin-sidebar .logo small { color:var(--text-muted); font-size:0.8rem; }
        .admin-nav a {
            display:flex; align-items:center; gap:12px; padding:12px 24px; color:var(--text-color);
            transition:0.3s; font-size:0.95rem; text-decoration:none; border-inline-start:3px solid transparent;
        }
        .admin-nav a:hover, .admin-nav a.active { background:rgba(93,203,202,0.1); color:var(--primary); border-color:var(--primary); }
        .admin-nav a svg { width:20px; height:20px; flex-shrink:0; }
        .admin-main { margin-inline-start:260px; flex:1; padding:30px; min-height:100vh; }
        .admin-topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; padding-bottom:20px; border-bottom:1px solid var(--border-color); }
        .admin-topbar h1 { font-size:1.8rem; color:var(--primary); }
        .admin-topbar-actions { display:flex; gap:10px; align-items:center; }
        .admin-topbar-actions .nav-btn { width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.05); border:1px solid var(--border-color); color:var(--text-color); display:flex; align-items:center; justify-content:center; font-weight:700; transition:0.3s; font-size:0.85rem; }
        .admin-topbar-actions .nav-btn:hover { background:var(--primary); color:#000; }
        .admin-card { background:var(--card-bg); border:1px solid var(--border-color); border-radius:16px; padding:24px; margin-bottom:24px; }
        .admin-card h3 { color:var(--primary); margin-bottom:16px; font-size:1.2rem; }
        .stats-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:20px; margin-bottom:30px; }
        .stat-card { background:var(--card-bg); border:1px solid var(--border-color); border-radius:16px; padding:24px; text-align:center; transition:0.3s; }
        .stat-card:hover { border-color:var(--primary); transform:translateY(-5px); }
        .stat-card .stat-number { font-size:2.5rem; color:var(--primary); font-weight:700; }
        .stat-card .stat-label { color:var(--text-muted); margin-top:8px; }
        .form-group { margin-bottom:16px; }
        .form-group label { display:block; margin-bottom:6px; color:var(--text-muted); font-size:0.9rem; }
        .form-group input, .form-group textarea, .form-group select {
            width:100%; padding:12px 16px; border-radius:10px; border:1px solid var(--border-color);
            background:rgba(255,255,255,0.03); color:var(--text-color); font-family:inherit; font-size:0.95rem; outline:none;
        }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color:var(--primary); }
        .form-group textarea { min-height:80px; resize:vertical; }
        .btn-admin { padding:10px 24px; border-radius:10px; font-weight:700; transition:0.3s; border:none; font-size:0.95rem; font-family:inherit; }
        .btn-admin-primary { background:var(--primary); color:#000; }
        .btn-admin-primary:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(93,203,202,0.3); }
        .btn-admin-danger { background:rgba(255,0,0,0.15); color:#ff6b6b; border:1px solid rgba(255,0,0,0.3); }
        .btn-admin-danger:hover { background:rgba(255,0,0,0.3); }
        .btn-admin-outline { background:transparent; color:var(--text-color); border:1px solid var(--border-color); }
        .btn-admin-outline:hover { border-color:var(--primary); color:var(--primary); }
        .admin-table { width:100%; border-collapse:collapse; }
        .admin-table th, .admin-table td { padding:12px 16px; text-align:start; border-bottom:1px solid var(--border-color); }
        .admin-table th { color:var(--primary); font-size:0.9rem; }
        .admin-table tr:hover { background:rgba(93,203,202,0.05); }
        .flash-msg { padding:12px 20px; border-radius:10px; margin-bottom:20px; }
        .flash-success { background:rgba(93,203,202,0.1); border:1px solid var(--primary); color:var(--primary); }
        .flash-error { background:rgba(255,0,0,0.1); border:1px solid rgba(255,0,0,0.3); color:#ff6b6b; }
        .inline-form { display:inline; }
        .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
        @media(max-width:768px) {
            .admin-sidebar { width:100%; position:relative; min-height:auto; }
            .admin-main { margin-inline-start:0; }
            body { flex-direction:column; }
            .form-row { grid-template-columns:1fr; }
        }
    </style>
</head>
<body class="theme-dark">
    <aside class="admin-sidebar">
        <div class="logo">
            <h2>NetPal</h2>
            <small>Admin Panel</small>
        </div>
        <nav class="admin-nav">
            <a href="{{ url_for('admin_dashboard') }}" class="{% if request.endpoint == 'admin_dashboard' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg> Dashboard
            </a>
            <a href="{{ url_for('admin_genius') }}" class="{% if request.endpoint == 'admin_genius' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> Live Editor
            </a>
            <a href="{{ url_for('admin_sections') }}" class="{% if request.endpoint in ['admin_sections','admin_subsections'] %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg> Sections
            </a>
            <a href="{{ url_for('admin_projects') }}" class="{% if request.endpoint in ['admin_projects','admin_projects_add','admin_projects_edit'] %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg> Projects
            </a>
            <a href="{{ url_for('admin_about') }}" class="{% if request.endpoint == 'admin_about' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg> About & Team
            </a>
            <a href="{{ url_for('admin_contact') }}" class="{% if request.endpoint == 'admin_contact' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg> Contact
            </a>
            <a href="{{ url_for('admin_site_content') }}" class="{% if request.endpoint == 'admin_site_content' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Site Content
            </a>
            <a href="{{ url_for('admin_logo') }}" class="{% if request.endpoint == 'admin_logo' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg> Logo
            </a>
            {% if current_user.role == 'super_admin' %}
            <a href="{{ url_for('admin_admins') }}" class="{% if request.endpoint == 'admin_admins' %}active{% endif %}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Admins
            </a>
            {% endif %}
            <a href="{{ url_for('admin_logout') }}" style="margin-top:20px;color:#ff6b6b;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg> Logout
            </a>
        </nav>
    </aside>
    <main class="admin-main">
        <div class="admin-topbar">
            <h1>{% block page_title %}Dashboard{% endblock %}</h1>
            <div class="admin-topbar-actions">
                <button class="nav-btn" onclick="toggleAdminTheme()" title="Toggle Theme">🌓</button>
                <button class="nav-btn" onclick="toggleAdminLang()" title="Toggle Language" id="adminLangBtn">EN</button>
                <span style="color:var(--text-muted);font-size:0.85rem;">{{ current_user.username }} ({{ current_user.role }})</span>
            </div>
        </div>
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}{% for cat, msg in messages %}
        <div class="flash-msg flash-{{ cat }}">{{ msg }}</div>
        {% endfor %}{% endif %}{% endwith %}
        {% block admin_content %}{% endblock %}
    </main>
    <script>
        function toggleAdminTheme() {
            document.body.classList.toggle('theme-dark');
            document.body.classList.toggle('theme-light');
        }
        function toggleAdminLang() {
            const html = document.documentElement;
            const btn = document.getElementById('adminLangBtn');
            if (html.dir === 'rtl') { html.dir='ltr'; html.lang='en'; btn.textContent='عربي'; }
            else { html.dir='rtl'; html.lang='ar'; btn.textContent='EN'; }
        }
    </script>
</body>
</html>
''')

# ============================================================
# templates/admin/dashboard.html
# ============================================================
write_file('templates/admin/dashboard.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Dashboard{% endblock %}
{% block admin_content %}
<div class="stats-grid">
    <div class="stat-card"><div class="stat-number">{{ stats.sections }}</div><div class="stat-label">Sections / أقسام</div></div>
    <div class="stat-card"><div class="stat-number">{{ stats.projects }}</div><div class="stat-label">Projects / مشاريع</div></div>
    <div class="stat-card"><div class="stat-number">{{ stats.team }}</div><div class="stat-label">Team / الفريق</div></div>
    <div class="stat-card"><div class="stat-number">{{ stats.admins }}</div><div class="stat-label">Admins / المدراء</div></div>
</div>
<div class="admin-card">
    <h3>Quick Actions / إجراءات سريعة</h3>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="{{ url_for('admin_projects_add') }}" class="btn-admin btn-admin-primary">+ Add Project / إضافة مشروع</a>
        <a href="{{ url_for('admin_genius') }}" class="btn-admin btn-admin-outline">Live Editor / المحرر المباشر</a>
        <a href="{{ url_for('admin_sections') }}" class="btn-admin btn-admin-outline">Manage Sections / إدارة الأقسام</a>
        <a href="/" target="_blank" class="btn-admin btn-admin-outline">View Site / عرض الموقع</a>
    </div>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/sections.html
# ============================================================
write_file('templates/admin/sections.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Sections / الأقسام{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>Add Section / إضافة قسم</h3>
    <form method="POST" action="{{ url_for('admin_sections_add') }}">
        <div class="form-row">
            <div class="form-group"><label>Arabic Name / الاسم بالعربي</label><input name="name_ar" required></div>
            <div class="form-group"><label>English Name / الاسم بالإنكليزي</label><input name="name_en" required></div>
        </div>
        <div class="form-group"><label>Slug (e.g. graphic, motion)</label><input name="slug" required pattern="[a-z0-9-]+"></div>
        <button type="submit" class="btn-admin btn-admin-primary">Add / إضافة</button>
    </form>
</div>
<div class="admin-card">
    <h3>All Sections / كل الأقسام</h3>
    <table class="admin-table">
        <tr><th>#</th><th>Arabic</th><th>English</th><th>Slug</th><th>Sub-sections</th><th>Actions</th></tr>
        {% for s in sections %}
        <tr>
            <td>{{ loop.index }}</td>
            <td>
                <form method="POST" action="{{ url_for('admin_sections_edit', sid=s.id) }}" class="inline-form" style="display:flex;gap:4px;">
                    <input name="name_ar" value="{{ s.name_ar }}" style="width:120px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-color);background:transparent;color:var(--text-color);font-family:inherit;">
            </td>
            <td>
                    <input name="name_en" value="{{ s.name_en }}" style="width:120px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-color);background:transparent;color:var(--text-color);font-family:inherit;">
            </td>
            <td>{{ s.slug }}</td>
            <td><a href="{{ url_for('admin_subsections', sid=s.id) }}" style="color:var(--primary);">{{ s.sub_sections|length }} subs →</a></td>
            <td style="display:flex;gap:6px;">
                    <button type="submit" class="btn-admin btn-admin-outline" style="padding:6px 12px;">Save</button>
                </form>
                <form method="POST" action="{{ url_for('admin_sections_delete', sid=s.id) }}" class="inline-form" onsubmit="return confirm('Delete this section and all its projects?')">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding:6px 12px;">Delete</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </table>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/subsections.html
# ============================================================
write_file('templates/admin/subsections.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Sub-sections: {{ section.name_en }} / {{ section.name_ar }}{% endblock %}
{% block admin_content %}
<a href="{{ url_for('admin_sections') }}" style="color:var(--primary);margin-bottom:20px;display:inline-block;">← Back to Sections</a>
<div class="admin-card">
    <h3>Add Sub-section / إضافة قسم فرعي</h3>
    <form method="POST" action="{{ url_for('admin_subsections_add') }}">
        <input type="hidden" name="section_id" value="{{ section.id }}">
        <div class="form-row">
            <div class="form-group"><label>Arabic / عربي</label><input name="name_ar" required></div>
            <div class="form-group"><label>English / إنكليزي</label><input name="name_en" required></div>
        </div>
        <div class="form-group"><label>Slug</label><input name="slug" required pattern="[a-z0-9-]+"></div>
        <button type="submit" class="btn-admin btn-admin-primary">Add</button>
    </form>
</div>
<div class="admin-card">
    <h3>Sub-sections</h3>
    <table class="admin-table">
        <tr><th>#</th><th>Arabic</th><th>English</th><th>Slug</th><th>Actions</th></tr>
        {% for sub in subs %}
        <tr>
            <td>{{ loop.index }}</td>
            <td><form method="POST" action="{{ url_for('admin_subsections_edit', subid=sub.id) }}" style="display:flex;gap:4px;">
                <input name="name_ar" value="{{ sub.name_ar }}" style="width:120px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-color);background:transparent;color:var(--text-color);font-family:inherit;"></td>
            <td><input name="name_en" value="{{ sub.name_en }}" style="width:120px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-color);background:transparent;color:var(--text-color);font-family:inherit;"></td>
            <td>{{ sub.slug }}</td>
            <td style="display:flex;gap:6px;">
                <button type="submit" class="btn-admin btn-admin-outline" style="padding:6px 12px;">Save</button></form>
                <form method="POST" action="{{ url_for('admin_subsections_delete', subid=sub.id) }}" onsubmit="return confirm('Delete?')">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding:6px 12px;">Delete</button></form>
            </td>
        </tr>
        {% endfor %}
    </table>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/projects.html
# ============================================================
write_file('templates/admin/projects.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Projects / المشاريع{% endblock %}
{% block admin_content %}
<div style="display:flex;gap:12px;align-items:center;margin-bottom:24px;flex-wrap:wrap;">
    <a href="{{ url_for('admin_projects_add') }}" class="btn-admin btn-admin-primary">+ Add Project / إضافة مشروع</a>
    <span style="color:var(--text-muted);">Filter:</span>
    <a href="{{ url_for('admin_projects') }}" class="btn-admin {% if not current_section %}btn-admin-primary{% else %}btn-admin-outline{% endif %}" style="padding:6px 16px;">All</a>
    {% for s in sections %}
    <a href="{{ url_for('admin_projects', section=s.slug) }}" class="btn-admin {% if current_section == s.slug %}btn-admin-primary{% else %}btn-admin-outline{% endif %}" style="padding:6px 16px;">{{ s.name_en }}</a>
    {% endfor %}
</div>
<div class="admin-card">
    <table class="admin-table">
        <tr><th>#</th><th>Cover</th><th>Title AR</th><th>Title EN</th><th>Section</th><th>Actions</th></tr>
        {% for p in projects %}
        <tr>
            <td>{{ loop.index }}</td>
            <td><img src="{{ p.cover_image }}" onerror="this.src='/static/uploads/'+this.dataset.fn" data-fn="{{ p.cover_image }}" style="width:80px;height:45px;object-fit:cover;border-radius:8px;"></td>
            <td>{{ p.title_ar[:30] }}</td>
            <td>{{ p.title_en[:30] }}</td>
            <td>{{ p.section.name_en if p.section else '' }}</td>
            <td style="display:flex;gap:6px;">
                <a href="{{ url_for('admin_projects_edit', pid=p.id) }}" class="btn-admin btn-admin-outline" style="padding:6px 12px;">Edit</a>
                <form method="POST" action="{{ url_for('admin_projects_delete', pid=p.id) }}" onsubmit="return confirm('Delete?')">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding:6px 12px;">Delete</button></form>
            </td>
        </tr>
        {% endfor %}
    </table>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/project_form.html
# ============================================================
write_file('templates/admin/project_form.html', r'''{% extends "admin/base.html" %}
{% block page_title %}{% if project %}Edit Project{% else %}Add Project{% endif %}{% endblock %}
{% block admin_content %}
<a href="{{ url_for('admin_projects') }}" style="color:var(--primary);margin-bottom:20px;display:inline-block;">← Back</a>
<div class="admin-card">
    <form method="POST" enctype="multipart/form-data" action="{% if project %}{{ url_for('admin_projects_edit', pid=project.id) }}{% else %}{{ url_for('admin_projects_add') }}{% endif %}">
        <div class="form-row">
            <div class="form-group"><label>Title Arabic / العنوان بالعربي</label><input name="title_ar" value="{{ project.title_ar if project else '' }}" required></div>
            <div class="form-group"><label>Title English / العنوان بالإنكليزي</label><input name="title_en" value="{{ project.title_en if project else '' }}" required></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Description AR / الوصف بالعربي</label><textarea name="description_ar">{{ project.description_ar if project else '' }}</textarea></div>
            <div class="form-group"><label>Description EN / الوصف بالإنكليزي</label><textarea name="description_en">{{ project.description_en if project else '' }}</textarea></div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Section / القسم</label>
                <select name="section_id" id="sectionSelect" required>
                    <option value="">Choose...</option>
                    {% for s in sections %}<option value="{{ s.id }}" {% if project and project.section_id == s.id %}selected{% endif %}>{{ s.name_en }} / {{ s.name_ar }}</option>{% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label>Sub-section / القسم الفرعي</label>
                <select name="sub_section_id" id="subSelect">
                    <option value="">None</option>
                    {% for sub in subs %}<option value="{{ sub.id }}" data-section="{{ sub.section_id }}" {% if project and project.sub_section_id == sub.id %}selected{% endif %}>{{ sub.name_en }} / {{ sub.name_ar }}</option>{% endfor %}
                </select>
            </div>
        </div>
        <div class="form-group"><label>Cover Image (upload) / صورة الغلاف</label><input type="file" name="cover_image" accept="image/*"></div>
        <div class="form-group"><label>Or Cover URL / أو رابط صورة</label><input name="cover_url" value="{{ project.cover_image if project else '' }}"></div>
        <div class="form-row">
            <div class="form-group"><label>Video URL / رابط فيديو</label><input name="video_url" value="{{ project.video_url or '' if project else '' }}"></div>
            <div class="form-group"><label>Website Link / رابط الموقع</label><input name="link_url" value="{{ project.link_url or '' if project else '' }}"></div>
        </div>
        <div class="form-group"><label>Tech Tags (comma separated)</label><input name="tech_tags" value="{{ project.tech_tags or '' if project else '' }}"></div>
        <button type="submit" class="btn-admin btn-admin-primary">{% if project %}Update / تحديث{% else %}Create / إنشاء{% endif %}</button>
    </form>
</div>
<script>
document.getElementById('sectionSelect').addEventListener('change', function() {
    const sid = this.value;
    document.querySelectorAll('#subSelect option[data-section]').forEach(o => {
        o.style.display = (!sid || o.dataset.section === sid) ? '' : 'none';
    });
});
</script>
{% endblock %}
''')

# ============================================================
# templates/admin/about.html
# ============================================================
write_file('templates/admin/about.html', r'''{% extends "admin/base.html" %}
{% block page_title %}About & Team / من نحن والفريق{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>About Text / نص من نحن</h3>
    <form method="POST" action="{{ url_for('admin_about_update') }}">
        <div class="form-row">
            <div class="form-group"><label>Title AR</label><input name="about_title_ar" value="{{ about_title.text_ar if about_title else '' }}"></div>
            <div class="form-group"><label>Title EN</label><input name="about_title_en" value="{{ about_title.text_en if about_title else '' }}"></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Text AR</label><textarea name="about_text_ar">{{ about_text.text_ar if about_text else '' }}</textarea></div>
            <div class="form-group"><label>Text EN</label><textarea name="about_text_en">{{ about_text.text_en if about_text else '' }}</textarea></div>
        </div>
        <button type="submit" class="btn-admin btn-admin-primary">Save / حفظ</button>
    </form>
</div>
<div class="admin-card">
    <h3>Add Team Member / إضافة عضو</h3>
    <form method="POST" action="{{ url_for('admin_team_add') }}" enctype="multipart/form-data">
        <div class="form-row">
            <div class="form-group"><label>Name AR</label><input name="name_ar" required></div>
            <div class="form-group"><label>Name EN</label><input name="name_en" required></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Role AR</label><input name="role_ar"></div>
            <div class="form-group"><label>Role EN</label><input name="role_en"></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Skills AR (comma-sep)</label><input name="skills_ar"></div>
            <div class="form-group"><label>Skills EN (comma-sep)</label><input name="skills_en"></div>
        </div>
        <div class="form-group"><label>Photo</label><input type="file" name="image" accept="image/*"></div>
        <button type="submit" class="btn-admin btn-admin-primary">Add / إضافة</button>
    </form>
</div>
<div class="admin-card">
    <h3>Team Members / أعضاء الفريق</h3>
    {% for m in members %}
    <div style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <form method="POST" action="{{ url_for('admin_team_edit', mid=m.id) }}" enctype="multipart/form-data">
            <div class="form-row">
                <div class="form-group"><label>Name AR</label><input name="name_ar" value="{{ m.name_ar }}"></div>
                <div class="form-group"><label>Name EN</label><input name="name_en" value="{{ m.name_en }}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Role AR</label><input name="role_ar" value="{{ m.role_ar }}"></div>
                <div class="form-group"><label>Role EN</label><input name="role_en" value="{{ m.role_en }}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Skills AR</label><input name="skills_ar" value="{{ m.skills_ar or '' }}"></div>
                <div class="form-group"><label>Skills EN</label><input name="skills_en" value="{{ m.skills_en or '' }}"></div>
            </div>
            <div class="form-group"><label>New Photo</label><input type="file" name="image" accept="image/*"></div>
            <div style="display:flex;gap:8px;">
                <button type="submit" class="btn-admin btn-admin-primary" style="padding:8px 16px;">Save</button>
        </form>
                <form method="POST" action="{{ url_for('admin_team_delete', mid=m.id) }}" onsubmit="return confirm('Delete?')">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding:8px 16px;">Delete</button>
                </form>
            </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/contact.html
# ============================================================
write_file('templates/admin/contact.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Contact / التواصل{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>Contact Information / معلومات التواصل</h3>
    <form method="POST" action="{{ url_for('admin_contact_update') }}">
        <div class="form-group"><label>WhatsApp Number / رقم الواتساب</label><input name="contact_whatsapp" value="{{ whatsapp.text_ar if whatsapp else '' }}" dir="ltr"></div>
        <div class="form-group"><label>Email / البريد الإلكتروني</label><input name="contact_email" value="{{ email.text_ar if email else '' }}" dir="ltr" type="email"></div>
        <button type="submit" class="btn-admin btn-admin-primary">Save / حفظ</button>
    </form>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/site_content.html
# ============================================================
write_file('templates/admin/site_content.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Site Content / محتوى الموقع{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>All Content Keys / جميع المحتويات</h3>
    {% for c in contents %}
    <div style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <form method="POST" action="{{ url_for('admin_site_content_update') }}">
            <input type="hidden" name="key_name" value="{{ c.key_name }}">
            <div style="color:var(--primary);font-weight:700;margin-bottom:8px;">{{ c.key_name }}</div>
            <div class="form-row">
                <div class="form-group"><label>Arabic / عربي</label><textarea name="text_ar" rows="2">{{ c.text_ar or '' }}</textarea></div>
                <div class="form-group"><label>English / إنكليزي</label><textarea name="text_en" rows="2">{{ c.text_en or '' }}</textarea></div>
            </div>
            <button type="submit" class="btn-admin btn-admin-primary" style="padding:6px 16px;">Save</button>
        </form>
    </div>
    {% endfor %}
</div>
<div class="admin-card">
    <h3>Add New Content / إضافة محتوى جديد</h3>
    <form method="POST" action="{{ url_for('admin_site_content_update') }}">
        <div class="form-group"><label>Key Name</label><input name="key_name" required></div>
        <div class="form-row">
            <div class="form-group"><label>Arabic</label><textarea name="text_ar" rows="2"></textarea></div>
            <div class="form-group"><label>English</label><textarea name="text_en" rows="2"></textarea></div>
        </div>
        <button type="submit" class="btn-admin btn-admin-primary">Add / إضافة</button>
    </form>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/logo.html
# ============================================================
write_file('templates/admin/logo.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Logo / الشعار{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>Upload Logo / رفع الشعار</h3>
    <form method="POST" action="{{ url_for('admin_logo_update') }}" enctype="multipart/form-data">
        <div class="form-row">
            <div class="form-group"><label>Dark Mode Logo (SVG/PNG)</label><input type="file" name="logo_dark" accept="image/*"></div>
            <div class="form-group"><label>Light Mode Logo (SVG/PNG)</label><input type="file" name="logo_light" accept="image/*"></div>
        </div>
        <div class="form-group"><label>Logo Size (px height) / حجم الشعار</label><input type="number" name="logo_size" value="{{ logo_content.text_ar if logo_content else '35' }}" min="20" max="200"></div>
        <button type="submit" class="btn-admin btn-admin-primary">Save / حفظ</button>
    </form>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/admins.html
# ============================================================
write_file('templates/admin/admins.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Admins / المدراء{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>Add Admin / إضافة مدير</h3>
    <form method="POST" action="{{ url_for('admin_admins_add') }}">
        <div class="form-row">
            <div class="form-group"><label>Username</label><input name="username" required></div>
            <div class="form-group"><label>Password</label><input name="password" type="password" required></div>
        </div>
        <div class="form-group">
            <label>Role</label>
            <select name="role"><option value="admin">Admin</option><option value="super_admin">Super Admin</option></select>
        </div>
        <button type="submit" class="btn-admin btn-admin-primary">Add / إضافة</button>
    </form>
</div>
<div class="admin-card">
    <h3>All Admins</h3>
    <table class="admin-table">
        <tr><th>Username</th><th>Role</th><th>Actions</th></tr>
        {% for a in admins %}
        <tr>
            <td>{{ a.username }}</td>
            <td>{{ a.role }}</td>
            <td>
                {% if a.id != current_user.id %}
                <form method="POST" action="{{ url_for('admin_admins_delete', aid=a.id) }}" onsubmit="return confirm('Delete?')">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding:6px 12px;">Delete</button>
                </form>
                {% else %}<span style="color:var(--text-muted);">Current</span>{% endif %}
            </td>
        </tr>
        {% endfor %}
    </table>
</div>
{% endblock %}
''')

# ============================================================
# templates/admin/genius.html
# ============================================================
write_file('templates/admin/genius.html', r'''{% extends "admin/base.html" %}
{% block page_title %}Live Editor / المحرر المباشر{% endblock %}
{% block admin_content %}
<div class="admin-card">
    <h3>Instructions / التعليمات</h3>
    <p style="color:var(--text-muted);line-height:1.8;">
        Click on any text below to edit it. Changes save automatically to both Arabic & English.<br>
        اضغط على أي نص أدناه لتعديله. التغييرات تُحفظ تلقائياً للعربية والإنكليزية.
    </p>
</div>

<div class="admin-card">
    <h3>Hero Section / القسم الرئيسي</h3>
    {% for key in ['hero_title','hero_subtitle'] %}
    <div class="genius-item" style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <div style="color:var(--primary);font-size:0.85rem;margin-bottom:8px;">{{ key }}</div>
        <div class="form-row">
            <div class="form-group"><label>AR</label><textarea class="genius-input" data-key="{{ key }}" data-lang="ar" rows="2">{{ content.get(key, {}).get('ar','') }}</textarea></div>
            <div class="form-group"><label>EN</label><textarea class="genius-input" data-key="{{ key }}" data-lang="en" rows="2">{{ content.get(key, {}).get('en','') }}</textarea></div>
        </div>
        <button class="btn-admin btn-admin-primary genius-save" data-key="{{ key }}" style="padding:6px 16px;">Save / حفظ</button>
        <span class="genius-status" data-key="{{ key }}" style="color:var(--primary);margin-inline-start:10px;font-size:0.85rem;"></span>
    </div>
    {% endfor %}
</div>

<div class="admin-card">
    <h3>About / من نحن</h3>
    {% for key in ['about_title','about_text','feat_1','feat_2','feat_3'] %}
    <div class="genius-item" style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <div style="color:var(--primary);font-size:0.85rem;margin-bottom:8px;">{{ key }}</div>
        <div class="form-row">
            <div class="form-group"><label>AR</label><textarea class="genius-input" data-key="{{ key }}" data-lang="ar" rows="2">{{ content.get(key, {}).get('ar','') }}</textarea></div>
            <div class="form-group"><label>EN</label><textarea class="genius-input" data-key="{{ key }}" data-lang="en" rows="2">{{ content.get(key, {}).get('en','') }}</textarea></div>
        </div>
        <button class="btn-admin btn-admin-primary genius-save" data-key="{{ key }}" style="padding:6px 16px;">Save</button>
        <span class="genius-status" data-key="{{ key }}"></span>
    </div>
    {% endfor %}
</div>

<div class="admin-card">
    <h3>Contact / التواصل</h3>
    {% for key in ['contact_title'] %}
    <div class="genius-item" style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <div style="color:var(--primary);font-size:0.85rem;margin-bottom:8px;">{{ key }}</div>
        <div class="form-row">
            <div class="form-group"><label>AR</label><textarea class="genius-input" data-key="{{ key }}" data-lang="ar" rows="2">{{ content.get(key, {}).get('ar','') }}</textarea></div>
            <div class="form-group"><label>EN</label><textarea class="genius-input" data-key="{{ key }}" data-lang="en" rows="2">{{ content.get(key, {}).get('en','') }}</textarea></div>
        </div>
        <button class="btn-admin btn-admin-primary genius-save" data-key="{{ key }}" style="padding:6px 16px;">Save</button>
        <span class="genius-status" data-key="{{ key }}"></span>
    </div>
    {% endfor %}
</div>

<div class="admin-card">
    <h3>Sections / الأقسام</h3>
    <p style="color:var(--text-muted);margin-bottom:16px;">Manage sections and sub-sections directly:</p>
    {% for sec in sections %}
    <div style="border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;">
        <div style="font-size:1.1rem;font-weight:700;color:var(--primary);">{{ sec.name_ar }} / {{ sec.name_en }}</div>
        <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px;">
            {% for sub in sec.sub_sections %}<span class="skill-tag" style="background:rgba(93,203,202,0.15);padding:6px 14px;border-radius:20px;">{{ sub.name_ar }} / {{ sub.name_en }}</span>{% endfor %}
        </div>
        <div style="margin-top:10px;"><a href="{{ url_for('admin_subsections', sid=sec.id) }}" style="color:var(--primary);font-size:0.9rem;">Edit sub-sections →</a></div>
    </div>
    {% endfor %}
    <a href="{{ url_for('admin_sections') }}" class="btn-admin btn-admin-outline">Manage All Sections / إدارة الأقسام</a>
</div>

<div class="admin-card">
    <h3>Projects Quick Access / وصول سريع للمشاريع</h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
        {% for sec in sections %}
        <a href="{{ url_for('admin_projects', section=sec.slug) }}" style="background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:20px;text-align:center;text-decoration:none;transition:0.3s;">
            <div style="color:var(--primary);font-weight:700;font-size:1.1rem;">{{ sec.name_en }}</div>
            <div style="color:var(--text-muted);font-size:0.85rem;margin-top:4px;">{{ sec.name_ar }}</div>
        </a>
        {% endfor %}
    </div>
</div>

<script>
document.querySelectorAll('.genius-save').forEach(btn => {
    btn.addEventListener('click', async () => {
        const key = btn.dataset.key;
        const arEl = document.querySelector(`.genius-input[data-key="${key}"][data-lang="ar"]`);
        const enEl = document.querySelector(`.genius-input[data-key="${key}"][data-lang="en"]`);
        const status = document.querySelector(`.genius-status[data-key="${key}"]`);
        try {
            const res = await fetch('/api/content/update', {
                method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
                body: JSON.stringify({key, text_ar: arEl.value, text_en: enEl.value})
            });
            if (res.ok) { status.textContent = '✓ Saved!'; setTimeout(() => status.textContent='', 2000); }
            else { status.textContent = '✗ Error'; status.style.color='#ff6b6b'; }
        } catch(e) { status.textContent = '✗ Error'; }
    });
});
</script>
{% endblock %}
''')

# ============================================================
# static/css/main.css
# ============================================================
write_file('static/css/main.css', r'''@font-face { font-family:'Co Headline'; src:url('../fonts/Co Headline Light.otf') format('opentype'); font-weight:300; font-style:normal; font-display:swap; }
@font-face { font-family:'Co Headline'; src:url('../fonts/Co Headline.otf') format('opentype'); font-weight:400; font-style:normal; font-display:swap; }
@font-face { font-family:'Co Headline'; src:url('../fonts/Co Headline Bold.otf') format('opentype'); font-weight:700; font-style:normal; font-display:swap; }

:root {
    --primary:#5DCBCA; --secondary:#126C73; --dark:#07444E; --white:#FFFFFF;
    --container-width:1200px; --section-pad:100px;
    --trans-speed:0.3s; --trans-ease:cubic-bezier(0.25,0.8,0.25,1);
}
.theme-dark {
    --bg-color:#07444E; --bg-gradient:radial-gradient(circle at center,#07444E 0%,#000 100%);
    --text-color:#FFF; --text-muted:#A3D5D5; --card-bg:rgba(0,0,0,0.2);
    --border-color:rgba(93,203,202,0.2); --scrollbar-bg:#07444E;
}
.theme-light {
    --bg-color:#F0FAFA; --bg-gradient:radial-gradient(circle at center,#EFF9F9 0%,#FFF 100%);
    --text-color:#07444E; --text-muted:#126C73; --card-bg:#FFF;
    --border-color:rgba(18,108,115,0.1); --scrollbar-bg:#EFF9F9;
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{font-family:'Co Headline',sans-serif;background:var(--bg-color);background-image:var(--bg-gradient);color:var(--text-color);transition:background var(--trans-speed),color var(--trans-speed);cursor:none;overflow-x:hidden;position:relative;min-height:100vh;}
a{text-decoration:none;color:inherit;cursor:none;} button{font-family:inherit;cursor:none;border:none;outline:none;background:none;}

::-webkit-scrollbar{width:6px;} ::-webkit-scrollbar-track{background:var(--scrollbar-bg);} ::-webkit-scrollbar-thumb{background:var(--primary);border-radius:10px;}

#custom-cursor{position:fixed;top:0;left:0;width:12px;height:12px;background:var(--primary);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width 0.2s,height 0.2s;mix-blend-mode:difference;}
#cursor-trail{position:fixed;top:0;left:0;width:30px;height:30px;border:1px solid rgba(93,203,202,0.5);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width 0.2s,height 0.2s,border-color 0.2s;}
body.hovering #custom-cursor{width:40px;height:40px;background:rgba(93,203,202,0.2);mix-blend-mode:normal;}
body.hovering #cursor-trail{border-color:transparent;}

/* Preloader with SVG draw animation */
#preloader{position:fixed;top:0;left:0;width:100%;height:100%;background:var(--bg-color);z-index:10000;display:flex;justify-content:center;align-items:center;}
.preloader-logo-wrap{position:relative;}
.draw-circle{stroke-dasharray:570;stroke-dashoffset:570;animation:drawCircle 2s ease forwards;}
.preloader-text{animation:fadeInText 1s ease forwards 1.5s;}
@keyframes drawCircle{to{stroke-dashoffset:0;}}
@keyframes fadeInText{to{opacity:1;}}

/* Floating Nav */
.floating-nav{position:fixed;top:20px;left:50%;transform:translateX(-50%);display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,0.02);backdrop-filter:blur(15px);border:1px solid rgba(93,203,202,0.2);padding:10px 30px;border-radius:50px;z-index:1000;width:90%;max-width:1000px;transition:all 0.3s;}
.theme-light .floating-nav{background:rgba(0,0,0,0.03);border-color:rgba(18,108,115,0.1);}
.nav-logo{font-size:1.5rem;font-weight:700;color:var(--primary);display:flex;align-items:center;}
.nav-logo-img{height:35px;width:auto;object-fit:contain;transition:0.8s cubic-bezier(0.2,0.8,0.2,1);}

/* Logo morph/draw animation instead of shake */
.theme-dark .nav-logo-img{filter:brightness(0) invert(1);animation:logoMorphDark 4s ease-in-out infinite;}
.theme-light .nav-logo-img{filter:none;animation:logoMorphLight 4s ease-in-out infinite;}
@keyframes logoMorphDark{
    0%,100%{filter:brightness(0) invert(1) drop-shadow(0 0 2px rgba(255,255,255,0.2));transform:scale(1);}
    25%{filter:brightness(0) invert(1) drop-shadow(0 0 8px rgba(93,203,202,0.6));transform:scale(1.02);}
    50%{filter:brightness(0) invert(1) drop-shadow(0 0 15px rgba(93,203,202,0.4));transform:scale(1.04) rotateY(5deg);}
    75%{filter:brightness(0) invert(1) drop-shadow(0 0 8px rgba(93,203,202,0.6));transform:scale(1.02) rotateY(-3deg);}
}
@keyframes logoMorphLight{
    0%,100%{filter:drop-shadow(0 0 2px rgba(18,108,115,0.2));transform:scale(1);}
    25%{filter:drop-shadow(0 0 8px rgba(18,108,115,0.4));transform:scale(1.02);}
    50%{filter:drop-shadow(0 0 15px rgba(18,108,115,0.3));transform:scale(1.04) rotateY(5deg);}
    75%{filter:drop-shadow(0 0 8px rgba(18,108,115,0.4));transform:scale(1.02) rotateY(-3deg);}
}

.nav-links{display:flex;gap:30px;}
.nav-links a{font-size:1.1rem;position:relative;color:var(--text-color);font-weight:300;transition:0.3s;}
.nav-links a::after{content:'';position:absolute;bottom:-5px;left:50%;width:0;height:2px;background:var(--primary);transition:0.3s;transform:translateX(-50%);}
.nav-links a:hover{color:var(--primary);} .nav-links a:hover::after{width:100%;}
.nav-controls{display:flex;gap:10px;}
.nav-btn{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.05);color:var(--text-color);display:flex;align-items:center;justify-content:center;border:1px solid var(--border-color);font-weight:bold;transition:0.3s;}
.theme-light .nav-btn{background:rgba(0,0,0,0.05);}
.nav-btn:hover{background:var(--primary);color:#000;transform:scale(1.05);}
.nav-btn svg{width:18px;height:18px;}

.container{max-width:var(--container-width);margin:0 auto;padding:0 20px;}
section{padding:var(--section-pad) 0;position:relative;z-index:2;}

/* Hero */
.hero{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:100px 0 0;overflow:hidden;position:relative;}
#three-canvas-container{position:absolute;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;}
.hero-logo-container{perspective:1200px;z-index:2;margin-bottom:30px;display:flex;justify-content:center;align-items:center;}
.hero-main-logo{width:clamp(200px,25vw,350px);transition:transform 0.5s cubic-bezier(0.2,0.8,0.2,1);transform-style:preserve-3d;}

/* Logo entrance: draw/form animation */
.theme-dark .hero-main-logo{animation:logoFormDark 2s cubic-bezier(0.2,0.8,0.2,1) forwards,heroFloat 6s ease-in-out infinite 2s;}
.theme-light .hero-main-logo{animation:logoFormLight 2s cubic-bezier(0.2,0.8,0.2,1) forwards,heroFloatLight 6s ease-in-out infinite 2s;}

@keyframes logoFormDark{
    0%{opacity:0;filter:brightness(0) invert(1) blur(30px);transform:scale(0.3) rotateZ(-30deg);}
    30%{opacity:0.5;filter:brightness(0) invert(1) blur(15px);transform:scale(0.7) rotateZ(-10deg);}
    60%{opacity:0.9;filter:brightness(0) invert(1) blur(5px);transform:scale(1.05) rotateZ(3deg);}
    100%{opacity:1;filter:brightness(0) invert(1) blur(0);transform:scale(1) rotateZ(0);}
}
@keyframes logoFormLight{
    0%{opacity:0;filter:blur(30px);transform:scale(0.3) rotateZ(-30deg);}
    30%{opacity:0.5;filter:blur(15px);transform:scale(0.7) rotateZ(-10deg);}
    60%{opacity:0.9;filter:blur(5px);transform:scale(1.05) rotateZ(3deg);}
    100%{opacity:1;filter:blur(0);transform:scale(1) rotateZ(0);}
}
@keyframes heroFloat{
    0%,100%{transform:translateY(0) rotateX(0) rotateY(0);filter:brightness(0) invert(1) drop-shadow(0 15px 35px rgba(93,203,202,0.25));}
    25%{transform:translateY(-12px) rotateX(3deg) rotateY(-3deg);filter:brightness(0) invert(1) drop-shadow(0 25px 45px rgba(93,203,202,0.35));}
    50%{transform:translateY(-20px) rotateX(-2deg) rotateY(4deg) scale(1.03);filter:brightness(0) invert(1) drop-shadow(0 35px 55px rgba(93,203,202,0.4));}
    75%{transform:translateY(-10px) rotateX(2deg) rotateY(-2deg);filter:brightness(0) invert(1) drop-shadow(0 20px 40px rgba(93,203,202,0.3));}
}
@keyframes heroFloatLight{
    0%,100%{transform:translateY(0);filter:drop-shadow(0 15px 25px rgba(18,108,115,0.2));}
    50%{transform:translateY(-20px) scale(1.03);filter:drop-shadow(0 30px 45px rgba(18,108,115,0.35));}
}

.hero-content{max-width:800px;z-index:2;padding:0 20px;}
.hero-title{font-size:clamp(1.8rem,5vw,4rem);font-weight:700;margin-bottom:20px;line-height:1.6;overflow:visible;padding-bottom:10px;}
.hero-subtitle{font-size:clamp(1.2rem,2vw,1.8rem);font-weight:300;color:var(--text-muted);margin-bottom:40px;letter-spacing:2px;}
.hero-cta{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;}
.btn{padding:15px 40px;border-radius:30px;font-size:1.1rem;font-weight:700;transition:all 0.3s cubic-bezier(0.175,0.885,0.32,1.275);display:inline-flex;align-items:center;justify-content:center;overflow:hidden;position:relative;border:2px solid var(--primary);}
.btn-primary{background:var(--primary);color:#000;}
.btn-primary:hover{box-shadow:0 0 25px rgba(93,203,202,0.6);transform:translateY(-5px) scale(1.05);}
.btn-outline{background:transparent;color:var(--text-color);}
.btn-outline:hover{background:rgba(93,203,202,0.1);transform:translateY(-5px) scale(1.05);}
.scroll-indicator{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);animation:bounce 2s infinite;opacity:0.7;}
@keyframes bounce{0%,20%,50%,80%,100%{transform:translateY(0) translateX(-50%);}40%{transform:translateY(-20px) translateX(-50%);}60%{transform:translateY(-10px) translateX(-50%);}}

/* Section Headers */
.section-header{text-align:center;margin-bottom:60px;}
.section-title{font-size:3rem;font-weight:700;color:var(--primary);margin-bottom:15px;}
.section-line{width:60px;height:3px;background:var(--primary);margin:0 auto;border-radius:2px;}

/* About */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
@media(max-width:900px){.about-grid{grid-template-columns:1fr;}}
.about-text h3{font-size:2.5rem;margin-bottom:25px;line-height:1.3;}
.about-text p{font-size:1.2rem;color:var(--text-muted);margin-bottom:30px;line-height:1.8;}
.about-features{list-style:none;}
.about-features li{display:flex;align-items:center;gap:10px;margin-bottom:15px;font-size:1.1rem;}
.about-features li::before{content:'◆';color:var(--primary);font-size:0.8rem;}

.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;}
.team-member{perspective:1000px;height:250px;}
.team-card-inner{position:relative;width:100%;height:100%;text-align:center;transition:transform 0.8s cubic-bezier(0.2,0.8,0.2,1);transform-style:preserve-3d;}
.team-member:hover .team-card-inner{transform:rotateY(180deg);}
.team-front,.team-back{position:absolute;width:100%;height:100%;backface-visibility:hidden;background:var(--card-bg);border:1px solid var(--border-color);border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;box-shadow:0 10px 30px rgba(0,0,0,0.1);}
.team-member:hover .team-front{border-color:var(--primary);box-shadow:0 0 20px rgba(93,203,202,0.3);}
.team-back{transform:rotateY(180deg);background:linear-gradient(135deg,var(--dark),var(--secondary));color:#fff;}
.theme-light .team-back{background:linear-gradient(135deg,var(--secondary),var(--primary));}
.team-img-wrap{width:100px;height:100px;border-radius:50%;overflow:hidden;margin-bottom:15px;border:3px solid var(--primary);}
.team-img-wrap img{width:100%;height:100%;object-fit:cover;}
.team-name{font-size:1.3rem;font-weight:700;margin-bottom:5px;}
.team-role{color:var(--primary);font-size:0.9rem;font-weight:300;text-transform:uppercase;letter-spacing:1px;}
.team-skills{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;}
.skill-tag{background:rgba(255,255,255,0.2);padding:5px 12px;border-radius:15px;font-size:0.85rem;}

/* Portfolio */
.portfolio-tabs{display:flex;justify-content:center;gap:15px;margin-bottom:30px;flex-wrap:wrap;}
.tab-btn{padding:12px 30px;border-radius:40px;background:transparent;border:1px solid var(--border-color);color:var(--text-color);font-weight:700;transition:all 0.4s cubic-bezier(0.2,0.8,0.2,1);font-size:1rem;position:relative;overflow:hidden;}
.tab-btn::before{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:var(--primary);transform:scaleY(0);transition:0.4s cubic-bezier(0.2,0.8,0.2,1);z-index:-1;transform-origin:bottom;}
.tab-btn.active,.tab-btn:hover{color:#000;border-color:var(--primary);transform:translateY(-3px);box-shadow:0 8px 20px rgba(93,203,202,0.2);}
.tab-btn.active::before,.tab-btn:hover::before{transform:scaleY(1);}

.portfolio-subcategories{display:flex;justify-content:center;gap:25px;margin-bottom:50px;flex-wrap:wrap;}
.sub-tab{font-size:1rem;color:var(--text-muted);position:relative;padding:5px 0;transition:0.3s;font-weight:300;letter-spacing:1px;background:none;border:none;}
.sub-tab::after{content:'';position:absolute;bottom:0;left:50%;width:0;height:2px;background:var(--primary);transition:0.3s;transform:translateX(-50%);}
.sub-tab.active,.sub-tab:hover{color:var(--primary);font-weight:700;}
.sub-tab.active::after,.sub-tab:hover::after{width:100%;}

.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:30px;align-items:start;}
@media(max-width:600px){.projects-grid{grid-template-columns:1fr;}}

.project-card{position:relative;border-radius:20px;overflow:hidden;background:#000;cursor:none;box-shadow:0 15px 35px rgba(0,0,0,0.3);transition:transform 0.6s cubic-bezier(0.2,0.8,0.2,1),box-shadow 0.6s;aspect-ratio:16/9;}
.project-card img{width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.2,0.8,0.2,1);filter:brightness(0.8);}
.project-overlay{position:absolute;bottom:0;left:0;width:100%;height:60%;background:linear-gradient(to top,rgba(0,0,0,0.9),transparent);display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;padding:40px;color:#fff;opacity:0;transition:opacity 0.4s;}
html[dir="rtl"] .project-overlay{align-items:flex-end;text-align:right;}
html[dir="ltr"] .project-overlay{align-items:flex-start;text-align:left;}
.project-card:hover{transform:translateY(-10px) scale(1.02);box-shadow:0 25px 50px rgba(93,203,202,0.25);z-index:10;}
.project-card:hover img{transform:scale(1.1);filter:brightness(0.5);}
.project-card:hover .project-overlay{opacity:1;}
.project-title{font-size:1.6rem;font-weight:700;transform:translateY(30px);transition:transform 0.5s 0.1s cubic-bezier(0.2,0.8,0.2,1);margin-bottom:5px;color:var(--primary);}
.project-card:hover .project-title{transform:translateY(0);}
.project-cat{font-size:0.9rem;letter-spacing:2px;text-transform:uppercase;transform:translateY(30px);transition:transform 0.5s 0.2s cubic-bezier(0.2,0.8,0.2,1);color:var(--white);opacity:0.7;}
.project-card:hover .project-cat{transform:translateY(0);}

body.project-hover #custom-cursor{width:80px;height:80px;background:var(--primary);mix-blend-mode:normal;color:#000;display:flex;align-items:center;justify-content:center;font-weight:bold;font-family:'Co Headline',sans-serif;font-size:13px;}
body.project-hover #custom-cursor::after{content:'VIEW';}
html[dir="rtl"] body.project-hover #custom-cursor::after{content:'عرض';}
body.project-hover #cursor-trail{opacity:0;}

/* Contact */
#portfolio{padding-bottom:50px;}
.contact-section{position:relative;text-align:center;padding:120px 0;overflow:hidden;margin-top:100px;}
.contact-bg{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0.03;z-index:-1;}
.contact-actions{display:flex;justify-content:center;gap:50px;margin-top:60px;flex-wrap:wrap;perspective:1000px;}
.contact-btn{width:300px;height:260px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(20px);border-radius:30px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;font-size:1.8rem;font-weight:700;transition:transform 0.1s;position:relative;overflow:hidden;transform-style:preserve-3d;}
.theme-light .contact-btn{background:rgba(0,0,0,0.05);border-color:rgba(0,0,0,0.1);}
.contact-btn svg{width:70px;height:70px;color:var(--primary);transform:translateZ(50px);transition:0.4s;}
.contact-btn span{transform:translateZ(30px);letter-spacing:1px;}
.contact-btn:hover{border-color:var(--primary);box-shadow:0 25px 60px rgba(93,203,202,0.15);}
.contact-btn:hover svg{filter:drop-shadow(0 0 10px var(--primary));}
.contact-btn::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(93,203,202,0.2) 0%,transparent 60%);opacity:0;transition:0.5s;pointer-events:none;}
.contact-btn:hover::before{opacity:1;}

/* Project Detail Page */
.project-detail-hero{position:relative;width:100%;height:50vh;min-height:350px;overflow:hidden;margin-top:80px;}
.project-detail-cover{width:100%;height:100%;}
.project-detail-cover img{width:100%;height:100%;object-fit:cover;}
.project-detail-overlay{position:absolute;bottom:0;left:0;width:100%;padding:30px 0;background:linear-gradient(to top,rgba(0,0,0,0.8),transparent);}
.breadcrumb{display:flex;gap:10px;align-items:center;color:rgba(255,255,255,0.8);font-size:1rem;}
.breadcrumb a{color:var(--primary);transition:0.3s;}
.breadcrumb a:hover{opacity:0.8;}

.project-detail-content{padding:60px 0 100px;}
.project-detail-header{margin-bottom:40px;}
.project-detail-title{font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:var(--primary);margin-bottom:16px;}
.project-detail-tags{display:flex;gap:10px;flex-wrap:wrap;}
.project-detail-desc{font-size:1.2rem;line-height:2;color:var(--text-muted);margin-bottom:40px;max-width:800px;}
.project-detail-link{margin-bottom:40px;display:inline-flex;}
.project-detail-video{margin-bottom:40px;}
.project-detail-gallery{display:flex;flex-direction:column;gap:30px;}
.project-real-image{width:100%;height:auto;border-radius:16px;border:1px solid var(--border-color);transition:0.3s;}
.project-real-image:hover{box-shadow:0 20px 50px rgba(93,203,202,0.15);}

/* 3D Glassmorphism cards */
.glass-card{background:rgba(255,255,255,0.03);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.08);border-radius:24px;transition:all 0.4s cubic-bezier(0.2,0.8,0.2,1);}
.glass-card:hover{border-color:rgba(93,203,202,0.3);box-shadow:0 20px 60px rgba(93,203,202,0.1);transform:translateY(-5px);}
.theme-light .glass-card{background:rgba(255,255,255,0.8);border-color:rgba(18,108,115,0.08);}

/* Footer */
.site-footer{border-top:1px solid var(--border-color);padding:30px 0;position:relative;overflow:hidden;background:transparent;display:flex;justify-content:center;align-items:center;}
.footer-content{display:flex;flex-direction:row;justify-content:space-between;align-items:center;width:100%;gap:20px;flex-wrap:wrap;}
.footer-logo{width:80px;transition:0.4s;}
.footer-logo:hover{transform:scale(1.1) rotate(5deg);filter:drop-shadow(0 0 10px var(--primary));}
.footer-madeby{font-size:0.9rem;color:var(--text-muted);opacity:0.8;letter-spacing:1px;font-weight:300;}

.hidden{display:none!important;}

/* Responsive */
@media(max-width:768px){
    .floating-nav{padding:8px 16px;border-radius:30px;}
    .nav-links{display:none;}
    .hero-title{font-size:1.5rem;}
    .section-title{font-size:2rem;}
    .contact-btn{width:100%;max-width:300px;height:200px;}
    .contact-actions{gap:20px;}
    .team-grid{grid-template-columns:1fr;}
}
''')

