        'pack': 'https://images.unsplash.com/photo-1605000797499-95a51c5269ae?w=800&q=80',
        'motion': 'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=800&q=80',
        'video': 'https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=800&q=80',
